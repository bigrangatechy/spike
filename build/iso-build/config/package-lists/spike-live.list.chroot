# Spike Stage-1 live image packages (chroot)
# Base is Ubuntu 26.04 via live-build bootstrap; this list adds live + usable shell.
# Only list packages that exist on resolute (verify with: apt-cache policy NAME).

# Live boot (Ubuntu casper stack — no ubiquity/Calamares)
casper
discover
laptop-detect
os-prober

# Kernel meta (lb also pulls linux-image via --linux-packages)
linux-generic

# Networking (live Wi-Fi / ethernet; full firmware set comes later)
network-manager
wpasupplicant
iw
# nmcli used by Spike Network applet / Settings as NM CLI helper (same package)
# (network-manager provides /usr/bin/nmcli)
net-tools
iproute2
iputils-ping

# Minimal admin / recovery shell
sudo
vim-tiny
nano
less
rsync
parted
gdisk
e2fsprogs
dosfstools
squashfs-tools
curl
ca-certificates
systemd
systemd-sysv
dbus

# Spike Shell runtime (Qt6 Widgets; session uses kwin later)
libqt6widgets6
libqt6gui6
libqt6core6t64
qt6-wayland
layer-shell-qt
liblayershellqtinterface6
# Standalone compositor for spike-session (no Plasma)
kwin-wayland
xwayland
dbus-user-session
# Seat access for starting KWin from a text VT (no display manager yet)
seatd
libseat1
# Visible pointer (without this KWin logs "Unable to load any cursor theme")
breeze-cursor-theme
# Breeze window decorations + Qt platform theme (no plasma-workspace / plasmashell).
# Verified: breeze / plasma-integration / xdg-desktop-portal-kde do not Depends on
# plasma-desktop or plasma-workspace. Do NOT add those packages — they fight Spike Shell.
breeze
# Explicit icon meta (also pulled by breeze → kf6-breeze-icon-theme). Spike-icons inherits it.
breeze-icon-theme
# Qt SVG icon engine — without this, Breeze SVG icons are null and the panel stays text-only.
qt6-svg-plugins
plasma-integration
xdg-desktop-portal
xdg-desktop-portal-kde
# Power actions from Spike Shell (logind asks polkit; without this → Access denied)
polkitd
# Volume applet (pactl) + Battery applet (UPower)
pulseaudio-utils
upower
alsa-utils
# Quiets PipeWire "RTKit error: ServiceUnknown" (optional but cheap).
rtkit

# Stage-3 live apps — KDE standalone set from CONSTRAINTS.md / DESIGN-DECISIONS.md.
# Spike Shell owns the shell; these are the application layer (not full Plasma).
# Alpha default apps: Mozilla .deb repo (config/spike-archives → archives/) for Firefox /
# Thunderbird — never Ubuntu Snap stubs. VLC + LibreOffice from Ubuntu universe.
# Flatpak also via Discover. No Snap. See STATE.md “Default apps”.
# Do not pull QtWebEngine browsers for Tier-1 RAM.
dolphin
konsole
kate
ark
kcalc
kde-spectacle
plasma-systemmonitor
plasma-discover
# Discover backends: Flatpak + apt/PackageKit. Never Snap.
flatpak
plasma-discover-backend-flatpak
appstream
apt-config-icons
packagekit
xdg-user-dirs
# Lockscreen greeter QML (Spike minimal LockScreen under breeze LNF)
qml6-module-qtquick-controls
qml6-module-qtquick-layouts
# Default user apps (Alpha)
firefox
thunderbird
vlc
libreoffice
libreoffice-qt6
libreoffice-kf6
libreoffice-plasma
libreoffice-style-breeze
libreoffice-gtk3
# Live/debug extras (not in the shipped app list, but useful on USB smoke tests)
htop
gparted
# Light Wayland terminal kept as Terminal=true launcher fallback (htop etc.)
foot

# Settings KCMs (DESKTOP.md Hardware/Network) — standalone packages, NOT plasma-desktop/workspace.
# Do NOT add plasma-desktop or plasma-workspace: they ship plasmashell autostart and fight Spike Shell.
# Safe KCM providers (verified: no Depends on plasma-workspace / plasma-desktop):
kscreen
plasma-pa
# plasma-pa Test button uses libcanberra → Pulse/PipeWire backend (Recommends only).
# Without this: "No such driver" and the test never hits the sink.
libcanberra-pulse
powerdevil
bluedevil
print-manager
# Accessibility (ACCESSIBILITY.md — always on ISO; idle until used)
orca
espeak-ng
at-spi2-core
maliit-keyboard
maliit-server-qt6
# Lightweight fallback OSK (X11/XWayland); Settings tries maliit first on Wayland
onboard

# Spike Rescue (DISASTER-RECOVERY.md) — RO mounts for Windows/macOS volumes
ntfs-3g
# hfsprogs may be unavailable on some Ubuntu releases; ignore if apt omits it
hfsprogs
lvm2

# Network KCM (plasma-nm) deferred: Depends on QtWebEngine (~200MB) — too heavy for Tier-1 4GB.
# Network/VPN Settings pages are Spike custom (not plasma-nm).

# Audio stack (MULTIMEDIA.md) — required for Sound KCM / session
pipewire
pipewire-pulse
wireplumber
# Bluetooth A2DP/HFP via PipeWire (bluez/bluedevil alone is not enough)
libspa-0.2-bluetooth

# Hardware helpers used later by installer detection (lightweight)
pciutils
usbutils
lshw
dmidecode

# Removable media / Discover places / tray Disks & USB (DESKTOP.md)
udisks2
gvfs
gvfs-backends
exfatprogs

# Security updates (BOOT-PROCESS.md / UPDATES.md) — Settings → Updates can enable
unattended-upgrades

# Desktop runtime helpers used by Spike Shell applets/Settings.
# Policy: if the shell/hardware path calls a binary, ship it on the ISO.
# Do NOT rely on .deb Recommends alone — live-build / apt often skips them.
bluez
rfkill
wmctrl
brightnessctl
libkf6kcmutils-bin
nm-connection-editor
xdg-utils
# Optional SMART for Storage page later; cheap and useful for support logs
smartmontools

# Prefer minimal firmware meta (linux-image-generic Depends: linux-firmware | linux-firmware-minimal).
# Full linux-firmware meta also pulls datacenter blobs (Mellanox/Prestera/…) — keep those out.
linux-firmware-minimal
# Misc blobs (USB controllers, sensors, etc.) — Tier-1 revival laptops vary widely
linux-firmware-misc

# Ensure full gnupg in chroot (bootstrap-include also pulls this; listed for clarity).
gnupg

# Tier 1 laptop firmware (Celeron N4020-class and similar old notebooks).
# Split packages from Ubuntu 26.04 — expand later if a device class is still missing.
linux-firmware-intel-wireless
linux-firmware-intel-graphics
firmware-sof-signed
linux-firmware-realtek
linux-firmware-qualcomm-wireless
linux-firmware-broadcom-wireless
linux-firmware-mediatek
linux-firmware-marvell-wireless
linux-firmware-amd-graphics

# ISO bootloader (Ubuntu dropped syslinux-themes-ubuntu-oneiric / gfxboot-theme-ubuntu).
# Keep *-bin + grub2-common in the squashfs so the installer can chroot-run
# grub-install --target=x86_64-efi|i386-pc. Do NOT add both grub-pc and
# grub-efi-amd64 metapackages — they Conflict with each other.
grub-pc-bin
grub-efi-amd64-bin
efibootmgr
grub2-common
genisoimage
syslinux
syslinux-common
# Ubuntu: isohybrid is in syslinux-utils (live-build Check_package wrongly names "syslinux")
syslinux-utils
