#!/bin/sh
# Spike live debug capture — Stage 3 (shell / session / seat / audio).
#
# Snapshot (default):
#   sudo spike-capture-logs
#
# Full dump (journal + dmesg + audio) — also used on debug boots:
#   sudo spike-capture-logs --full
#
# Arm logging *before* spike-session, then finalize after:
#   sudo spike-capture-logs --follow     # starts journal follow into USB capture dir
#   spike-session
#   sudo spike-capture-logs --finalize
set -eu

TS="$(date -u +%Y%m%dT%H%M%SZ)"
HOST="$(hostname 2>/dev/null || echo spike-live)"
MODE=snapshot
FULL=0
# Kernel cmdline debug / spike.capture → always take a full dump.
if grep -qw debug /proc/cmdline 2>/dev/null || grep -qw spike.capture /proc/cmdline 2>/dev/null; then
  FULL=1
fi

case "${1:-}" in
  --follow|-f) MODE=follow ;;
  --finalize|--stop) MODE=finalize ;;
  --full) MODE=snapshot; FULL=1 ;;
  --help|-h)
    cat <<'EOF'
Usage: spike-capture-logs [--follow|--finalize|--full]

  (default)   Snapshot to USB writable / log-persistence.
  --full      Snapshot plus full journal, dmesg, and audio diagnostics.
  --follow    Capture full journal continuously (run before/with session).
  --finalize  Stop --follow, copy spike-session.log, write a fresh snapshot.

On boots with kernel cmdline "debug" or "spike.capture", snapshots are --full
and the boot service arms --follow automatically.
EOF
    exit 0
    ;;
  "") ;;
  *)
    echo "unknown option: $1 (try --help)" >&2
    exit 1
    ;;
esac

STATE_DIR="/run/spike-capture"
FOLLOW_PID_FILE="${STATE_DIR}/follow.pid"
FOLLOW_OUT_FILE="${STATE_DIR}/follow.out"
FOLLOW_DIR_FILE="${STATE_DIR}/follow.dir"

resolve_out_base() {
  OUT=""
  for candidate in \
    /log-persistence \
    /cdrom \
    /media/writable \
    /mnt/writable
  do
    if [ -d "$candidate" ] && [ -w "$candidate" ]; then
      OUT="$candidate"
      break
    fi
  done

  if [ -z "$OUT" ] && command -v findmnt >/dev/null 2>&1; then
    W="$(findmnt -n -o TARGET -S LABEL=writable 2>/dev/null || true)"
    if [ -n "$W" ] && [ -w "$W" ]; then
      OUT="$W"
    fi
  fi

  if [ -z "$OUT" ]; then
    OUT="/var/log"
  fi
  echo "$OUT"
}

write_snapshot_into() {
  # $1 = capture directory
  cap="$1"
  mkdir -p "$cap" "$cap/session-logs" "$cap/audio"

  {
    echo "spike-capture ${TS} host=${HOST}"
    echo "cmdline: $(cat /proc/cmdline 2>/dev/null || true)"
    echo "uname: $(uname -a 2>/dev/null || true)"
    echo "focus: shell/session/audio"
    echo "mode: ${MODE}"
    echo "full: ${FULL}"
  } >"$cap/meta.txt"

  {
    echo "=== which ==="
    command -v spike-config || echo "MISSING"
    echo "=== version ==="
    spike-config --version 2>&1 || true
    echo "=== state ==="
    spike-config --state 2>&1 || true
  } >"$cap/spike-config.txt" 2>&1 || true

  {
    dpkg -l 'spike-config' 'spike-shell' 'kwin-wayland' 'layer-shell-qt' \
      'liblayershellqtinterface6' 'pipewire' 'pipewire-pulse' 'wireplumber' \
      'plasma-pa' 'firmware-sof-signed' 'breeze' 'breeze-icon-theme' \
      'kf6-breeze-icon-theme' 'qt6-svg-plugins' 'libqt6svg6' 'pulseaudio-utils' \
      'upower' 'alsa-utils' 'rtkit' 'xdg-desktop-portal' 'xdg-desktop-portal-kde' \
      'libspa-0.2-bluetooth' \
      2>&1 || true
    ls -la /usr/bin/spike-config /usr/bin/spike-shell /usr/bin/spike-session 2>&1 || true
    ls -la /usr/share/icons/spike-icons/index.theme \
      /usr/share/wireplumber/wireplumber.conf.d/51-spike-sof-hdmi-disable.conf \
      /usr/share/color-schemes/SpikeDark.colors \
      /etc/pipewire/pipewire.conf.d/99-spike.conf \
      /usr/share/alsa/ucm2/Intel/sof-essx8336/HiFi.conf 2>&1 || true
    wc -c /usr/share/wireplumber/wireplumber.conf.d/51-spike-sof-hdmi-disable.conf \
      /usr/share/color-schemes/SpikeDark.colors \
      /etc/pipewire/pipewire.conf.d/99-spike.conf \
      /usr/share/alsa/ucm2/Intel/sof-essx8336/HiFi.conf 2>&1 || true
    echo "=== sof-essx8336 HiFi HDMI include? ==="
    grep -n 'Include.hdmi\|HDMI\|hdmi' /usr/share/alsa/ucm2/Intel/sof-essx8336/HiFi.conf 2>&1 || echo "(none — good)"
    ls -la /usr/lib/*/qt6/plugins/iconengines/ 2>&1 || true
    ls -la /var/lib/spike/config 2>&1 || true
  } >"$cap/packages.txt" 2>&1 || true

  {
    echo "=== which ==="
    command -v spike-shell || echo "spike-shell MISSING"
    command -v spike-session || echo "spike-session MISSING"
    command -v kwin_wayland || echo "kwin_wayland MISSING"
    echo "=== env (sanitized) ==="
    echo "XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-}"
    echo "XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-}"
    echo "WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}"
    echo "DISPLAY=${DISPLAY:-}"
    echo "XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-}"
    echo "=== loginctl ==="
    loginctl 2>&1 || true
    echo "=== seat0 ==="
    loginctl show-seat seat0 2>&1 || true
    echo "=== sessions ==="
    loginctl list-sessions --no-legend 2>&1 || true
  } >"$cap/session.txt" 2>&1 || true

  # Always keep a focused shell filter for quick reads.
  journalctl -b --no-pager \
    -g 'spike-shell|spike-session|spike-config|kwin|wayland|libinput|seat|drm|LayerShell|spike-detect|pipewire|wireplumber|sof-|ASoC|pulse' \
    >"$cap/journal-shell.txt" 2>&1 || true

  # Audio diagnostics must run as the graphical session user — root has no
  # XDG_RUNTIME_DIR / pulse socket (previous captures showed "Connection refused").
  {
    echo "=== aplay -l ==="
    aplay -l 2>&1 || true
    echo "=== session-user audio (pactl / wpctl / systemctl --user) ==="
    ran_user_audio=0
    for rd in /run/user/*; do
      [ -d "$rd" ] || continue
      uid="$(basename "$rd")"
      case "$uid" in
        *[!0-9]*) continue ;;
      esac
      [ -S "$rd/pulse/native" ] || [ -S "$rd/pipewire-0" ] || [ -d "$rd" ] || continue
      user="$(getent passwd "$uid" | cut -d: -f1 || true)"
      [ -n "$user" ] || continue
      [ "$user" = root ] && continue
      echo "--- as ${user} (uid=${uid} XDG_RUNTIME_DIR=${rd}) ---"
      if command -v runuser >/dev/null 2>&1; then
        runuser -u "$user" -- env XDG_RUNTIME_DIR="$rd" \
          DBUS_SESSION_BUS_ADDRESS="unix:path=${rd}/bus" \
          sh -c '
            echo "=== pactl info ==="
            pactl info 2>&1 || true
            echo "=== pactl short sinks ==="
            pactl list short sinks 2>&1 || true
            echo "=== wpctl status ==="
            wpctl status 2>&1 || true
            echo "=== systemctl --user pipewire* ==="
            systemctl --user status pipewire.service pipewire.socket wireplumber.service \
              pipewire-pulse.service pipewire-pulse.socket --no-pager 2>&1 || true
          ' 2>&1 || true
        ran_user_audio=1
        break
      fi
    done
    if [ "$ran_user_audio" -eq 0 ]; then
      echo "(no /run/user session found — falling back to root; expect Connection refused)"
      echo "=== pactl info ==="
      pactl info 2>&1 || true
      echo "=== wpctl status ==="
      wpctl status 2>&1 || true
      echo "=== systemctl --user (pipewire) ==="
      systemctl --user status pipewire.service pipewire.socket wireplumber.service \
        pipewire-pulse.service pipewire-pulse.socket --no-pager 2>&1 || true
    fi
    echo "=== journal pipewire/wireplumber/sof (boot) ==="
    journalctl -b --no-pager -u 'pipewire*' -u 'wireplumber*' 2>&1 | tail -n 200 || true
    journalctl -b --no-pager -k 2>&1 | grep -iE 'sof-|ASoC|snd_|essx|pipewire' | tail -n 200 || true
  } >"$cap/audio/diagnostics.txt" 2>&1 || true

  if [ "$FULL" = 1 ]; then
    journalctl -b --no-pager >"$cap/journal-full.txt" 2>&1 || true
    dmesg >"$cap/dmesg.txt" 2>&1 || true
    journalctl -b -k --no-pager >"$cap/journal-kernel.txt" 2>&1 || true
    cp -a /var/log/syslog "$cap/syslog.copy" 2>/dev/null || true
    cp -a /var/log/kern.log "$cap/kern.log.copy" 2>/dev/null || true
  fi

  copied_session=0
  for f in /run/user/*/spike-session.log /tmp/spike-session.*.log \
    /var/log/spike/session-latest.log \
    /var/log/spike-session-latest.log \
    /log-persistence/spike-session-latest.log \
    /media/writable/spike-session-latest.log \
    /mnt/writable/spike-session-latest.log
  do
    if [ -f "$f" ]; then
      cp -a "$f" "$cap/session-logs/" 2>/dev/null || true
      copied_session=1
    fi
  done
  if command -v findmnt >/dev/null 2>&1; then
    w="$(findmnt -n -o TARGET -S LABEL=writable 2>/dev/null || true)"
    if [ -n "$w" ] && [ -f "${w}/spike-session-latest.log" ]; then
      cp -a "${w}/spike-session-latest.log" "$cap/session-logs/" 2>/dev/null || true
      copied_session=1
    fi
  fi
  if [ "$copied_session" -eq 0 ]; then
    echo "no spike-session.log found" >"$cap/session-logs/README.txt"
  fi

  free -h >"$cap/memory.txt" 2>&1 || true
  df -h >"$cap/disk.txt" 2>&1 || true

  echo "$cap" >"$cap/CAPTURE_PATH.txt"
  echo "I: spike-capture wrote $cap (full=${FULL})"
  ls -la "$cap" || true
}

stop_follow() {
  if [ -f "$FOLLOW_PID_FILE" ]; then
    pid="$(cat "$FOLLOW_PID_FILE" 2>/dev/null || true)"
    if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      sleep 0.3 2>/dev/null || true
      kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$FOLLOW_PID_FILE"
  fi
}

case "$MODE" in
  follow)
    if [ -f "$FOLLOW_PID_FILE" ]; then
      old="$(cat "$FOLLOW_PID_FILE" 2>/dev/null || true)"
      if [ -n "${old:-}" ] && kill -0 "$old" 2>/dev/null; then
        echo "I: follow already running (pid $old) → $(cat "$FOLLOW_DIR_FILE" 2>/dev/null || echo '?')"
        exit 0
      fi
      stop_follow
    fi

    base="$(resolve_out_base)"
    OUT="${base}/spike-capture-${TS}"
    mkdir -p "$OUT" "$STATE_DIR"
    {
      echo "spike-capture-follow ${TS} host=${HOST}"
      echo "cmdline: $(cat /proc/cmdline 2>/dev/null || true)"
      echo "armed: full journal follow (no grep filter)"
      echo "optional: sudo spike-capture-logs --finalize"
    } >"$OUT/meta.txt"

    # Full journal follow — needed to catch PipeWire/SOF spam and login issues.
    if command -v stdbuf >/dev/null 2>&1; then
      stdbuf -oL journalctl -f -n 200 --no-pager >"$OUT/journal-follow.txt" 2>&1 &
    else
      journalctl -f -n 200 --no-pager >"$OUT/journal-follow.txt" 2>&1 &
    fi
    echo $! >"$FOLLOW_PID_FILE"
    echo "$OUT" >"$FOLLOW_DIR_FILE"
    echo "$OUT/journal-follow.txt" >"$FOLLOW_OUT_FILE"

    (
      while [ -f "$FOLLOW_PID_FILE" ]; do
        sync 2>/dev/null || true
        sleep 2
      done
    ) >/dev/null 2>&1 &

    # Also write an immediate full snapshot alongside the follow stream.
    FULL=1 write_snapshot_into "$OUT"

    echo "I: follow armed → $OUT"
    echo "I: journal → $OUT/journal-follow.txt (survives reboot; finalize optional)"
    echo "I: next: live autologin should start spike-session; or Ctrl+Alt+F2 and run it as user spike"
    ;;

  finalize)
    OUT=""
    if [ -f "$FOLLOW_DIR_FILE" ]; then
      OUT="$(cat "$FOLLOW_DIR_FILE")"
    fi
    stop_follow
    rm -f "$FOLLOW_OUT_FILE" "$FOLLOW_DIR_FILE"

    if [ -z "$OUT" ] || [ ! -d "$OUT" ]; then
      base="$(resolve_out_base)"
      OUT="${base}/spike-capture-${TS}"
      echo "W: no active --follow dir; writing fresh snapshot to $OUT" >&2
    fi

    FULL=1 write_snapshot_into "$OUT"
    ;;

  snapshot)
    base="$(resolve_out_base)"
    OUT="${base}/spike-capture-${TS}"
    write_snapshot_into "$OUT"
    ;;
esac
