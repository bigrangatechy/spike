# Spike live KDE defaults — SpikeDark tint over Breeze widgets (no plasma-workspace).
# Color groups are inlined so Dolphin/Kate still get dark chrome if ColorScheme
# lookup fails (plasma-integration otherwise falls back to BreezeLight = white
# windows with SpikeDark's near-white text).

[General]
ColorScheme=SpikeDark

[KDE]
LookAndFeelPackage=org.kde.breeze.desktop
widgetStyle=Breeze

[Icons]
Theme=breeze-dark

[CursorTheme]
ThemeName=breeze_cursors
Size=24

