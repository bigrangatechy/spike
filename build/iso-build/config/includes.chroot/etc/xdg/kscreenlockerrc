# Spike: do NOT use KWin/kscreenlocker idle autolock.
# Autolock + logind IdleAction=suspend was locking then sleeping; greeter without
# full Plasma QML shows “screen locker is broken”. SpikeLockScreen handles
# Session menu + PrepareForSleep. Suspend-time greeter uses our LockScreen.qml.
[Daemon]
Autolock=false
LockOnResume=false
Timeout=0
LockGrace=0
RequirePassword=true
