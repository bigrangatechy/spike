# Spike live defaults — Breeze decorations without plasma-workspace (BRANDING.md).
[org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze

[Windows]
BorderlessMaximizedWindows=false

# Overview effect needs milou / kwin private QML we do not ship — disable noise.
# Night Light plugin must stay on for tray/Settings color temperature.
[Plugins]
overviewEnabled=false
nightlightEnabled=true
