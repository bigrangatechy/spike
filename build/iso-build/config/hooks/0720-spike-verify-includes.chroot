#!/bin/sh
# Fail the ISO build if critical Spike includes landed empty (caught WP/SpikeDark
# shipping as 0-byte and WirePlumber ignoring them).
set -eu

fail=0
check() {
  f="$1"
  min="${2:-1}"
  if [ ! -f "$f" ]; then
    echo "E: missing critical include: $f" >&2
    fail=1
    return
  fi
  bytes="$(wc -c <"$f" | tr -d ' ')"
  if [ "$bytes" -lt "$min" ]; then
    echo "E: critical include too small (${bytes}B < ${min}B): $f" >&2
    fail=1
  else
    echo "I: ok ${bytes}B $f"
  fi
}

check /usr/share/wireplumber/wireplumber.conf.d/51-spike-sof-hdmi-disable.conf 100
check /usr/share/color-schemes/SpikeDark.colors 500
check /usr/share/spike/wallpapers/Coastal-Run.png 10000
check /etc/xdg/kwinrc 50
check /etc/xdg/kdeglobals 500
check /etc/xdg/menus/applications.menu 500
check /usr/share/icons/spike-icons/index.theme 50
check /etc/pipewire/pipewire.conf.d/99-spike.conf 50
check /usr/share/alsa/ucm2/Intel/sof-essx8336/HiFi.conf 500
check /etc/casper.conf 50
check /etc/profile.d/99-spike-autostart-session.sh 50

# sof-essx8336 HiFi must NOT pull HDMI (causes ASoC -5 spam + auto_null only).
# Match an active Include only — comments may mention the upstream directive.
if grep -E '^[[:space:]]*Include\.hdmi' /usr/share/alsa/ucm2/Intel/sof-essx8336/HiFi.conf >/dev/null 2>&1; then
  echo "E: sof-essx8336 HiFi.conf still includes HDMI — remove Include.hdmi" >&2
  fail=1
elif ! grep -q 'SectionVerb' /usr/share/alsa/ucm2/Intel/sof-essx8336/HiFi.conf 2>/dev/null; then
  echo "E: sof-essx8336 HiFi.conf missing SectionVerb" >&2
  fail=1
else
  echo "I: sof-essx8336 HiFi.conf has no HDMI include"
fi

# Live user must be spike (not ubuntu).
if ! grep -q 'USERNAME="spike"' /etc/casper.conf 2>/dev/null; then
  echo "E: /etc/casper.conf USERNAME is not spike" >&2
  fail=1
else
  echo "I: casper USERNAME=spike"
fi

# SVG icon engine required for Breeze panel icons.
if [ ! -e /usr/lib/x86_64-linux-gnu/qt6/plugins/iconengines/libqsvgicon.so ] &&
   ! ls /usr/lib/*/qt6/plugins/iconengines/libqsvgicon.so >/dev/null 2>&1; then
  echo "E: qt6 SVG icon engine missing (install qt6-svg-plugins)" >&2
  fail=1
else
  echo "I: qt6 SVG icon engine present"
fi

if [ ! -x /usr/bin/spike-rescue ]; then
  echo "E: spike-rescue missing (package spike-rescue into includes.chroot)" >&2
  fail=1
else
  echo "I: spike-rescue present"
fi

if [ ! -x /usr/lib/spike/spike-rescue-mount ]; then
  echo "E: spike-rescue-mount helper missing" >&2
  fail=1
elif [ ! -f /etc/sudoers.d/spike-rescue ]; then
  echo "E: /etc/sudoers.d/spike-rescue missing (passwordless RO mounts)" >&2
  fail=1
else
  echo "I: spike-rescue mount helper + sudoers present"
fi

if [ ! -x /usr/bin/spike-installer ]; then
  echo "E: spike-installer missing (package spike-installer into includes.chroot)" >&2
  fail=1
else
  echo "I: spike-installer present"
fi

if [ ! -x /usr/lib/spike/spike-install-helper ]; then
  echo "E: spike-install-helper missing" >&2
  fail=1
elif [ ! -f /etc/sudoers.d/spike-installer ]; then
  echo "E: /etc/sudoers.d/spike-installer missing" >&2
  fail=1
else
  echo "I: spike-install-helper + sudoers present"
fi

if [ ! -x /usr/bin/spike-migration ]; then
  echo "E: spike-migration missing (package spike-migration into includes.chroot)" >&2
  fail=1
else
  echo "I: spike-migration present"
fi

# Default apps must be real .debs (Mozilla), not Ubuntu Snap stubs.
for app in firefox thunderbird vlc; do
  if ! command -v "$app" >/dev/null 2>&1 && [ ! -x "/usr/bin/$app" ]; then
    echo "E: default app missing: $app" >&2
    fail=1
  else
    echo "I: default app present: $app"
  fi
done
if ! dpkg-query -W -f='${Status}' firefox 2>/dev/null | grep -q "install ok installed"; then
  echo "E: firefox package not installed" >&2
  fail=1
elif dpkg-query -W -f='${Version}' firefox 2>/dev/null | grep -qi snap; then
  echo "E: firefox is Ubuntu Snap stub — need packages.mozilla.org" >&2
  fail=1
else
  echo "I: firefox is non-Snap .deb ($(dpkg-query -W -f='${Version}' firefox))"
fi
if ! dpkg-query -W -f='${Status}' thunderbird 2>/dev/null | grep -q "install ok installed"; then
  echo "E: thunderbird package not installed" >&2
  fail=1
elif dpkg-query -W -f='${Version}' thunderbird 2>/dev/null | grep -qi snap; then
  echo "E: thunderbird is Ubuntu Snap stub — need packages.mozilla.org" >&2
  fail=1
else
  echo "I: thunderbird is non-Snap .deb ($(dpkg-query -W -f='${Version}' thunderbird))"
fi
if ! dpkg-query -W -f='${Status}' libreoffice-writer 2>/dev/null | grep -q "install ok installed" \
   && ! dpkg-query -W -f='${Status}' libreoffice 2>/dev/null | grep -q "install ok installed"; then
  echo "E: libreoffice missing" >&2
  fail=1
else
  echo "I: libreoffice present"
fi
if [ ! -f /etc/apt/sources.list.d/mozilla.list ] && [ ! -f /etc/apt/sources.list.d/mozilla.list.chroot ]; then
  # live-build may name it mozilla.list from archives
  if ! ls /etc/apt/sources.list.d/mozilla* >/dev/null 2>&1; then
    echo "E: Mozilla APT source missing under /etc/apt/sources.list.d/" >&2
    fail=1
  else
    echo "I: Mozilla APT source present"
  fi
else
  echo "I: Mozilla APT source present"
fi

# Mozilla .deb AppArmor stubs (profile-cannot-be-loaded if Ubuntu confined profiles win).
if [ ! -f /etc/apparmor.d/firefox ]; then
  echo "E: /etc/apparmor.d/firefox missing (Mozilla AppArmor stub)" >&2
  fail=1
else
  echo "I: apparmor firefox stub present"
fi
if [ ! -f /etc/apparmor.d/thunderbird ]; then
  echo "E: /etc/apparmor.d/thunderbird missing (Mozilla AppArmor stub)" >&2
  fail=1
else
  echo "I: apparmor thunderbird stub present"
fi
if [ -f /etc/apparmor.d/usr.bin.firefox ] || [ -f /etc/apparmor.d/usr.bin.thunderbird ]; then
  echo "W: confined usr.bin.firefox/thunderbird still present — 0730 hook should remove"
fi

# Discover / AppStream / Flatpak
if ! command -v flatpak >/dev/null 2>&1; then
  echo "E: flatpak missing (Discover Flatpak backend)" >&2
  fail=1
else
  echo "I: flatpak present"
fi
if ! dpkg-query -W -f='${Status}' plasma-discover-backend-flatpak 2>/dev/null | grep -q "install ok installed"; then
  echo "E: plasma-discover-backend-flatpak missing" >&2
  fail=1
else
  echo "I: plasma-discover-backend-flatpak present"
fi
if ! command -v appstreamcli >/dev/null 2>&1; then
  echo "E: appstreamcli missing" >&2
  fail=1
else
  echo "I: appstreamcli present"
fi
if [ ! -f /usr/share/plasma/look-and-feel/org.kde.breeze.desktop/contents/lockscreen/LockScreen.qml ]; then
  echo "E: Spike lockscreen QML missing under breeze LNF" >&2
  fail=1
else
  echo "I: Spike lockscreen QML present"
fi
if command -v xdg-user-dirs-update >/dev/null 2>&1; then
  echo "I: xdg-user-dirs present"
else
  echo "E: xdg-user-dirs missing" >&2
  fail=1
fi

# Desktop / hardware runtime — must be on the ISO (not optional Recommends).
# Policy: build/iso-build/config/package-lists/README.md
need_pkg() {
  pkg="$1"
  if ! dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed"; then
    echo "E: required package missing from ISO: $pkg" >&2
    fail=1
  else
    echo "I: required package present: $pkg"
  fi
}
need_bin() {
  bin="$1"
  if ! command -v "$bin" >/dev/null 2>&1; then
    echo "E: required binary missing from ISO: $bin" >&2
    fail=1
  else
    echo "I: required binary present: $bin"
  fi
}

need_pkg udisks2
need_pkg gvfs
need_pkg bluez
need_pkg network-manager
need_pkg pipewire
need_pkg seatd
need_pkg kwin-wayland
need_pkg polkitd
need_pkg linux-firmware-minimal
need_pkg linux-firmware-intel-wireless
need_pkg linux-firmware-realtek
need_pkg linux-firmware-broadcom-wireless
need_pkg linux-firmware-qualcomm-wireless
need_pkg linux-firmware-misc
need_pkg pciutils
need_pkg usbutils
need_pkg lshw
need_pkg dmidecode

need_bin udisksctl
need_bin rfkill
need_bin wmctrl
need_bin brightnessctl
need_bin playerctl
need_bin bluetoothctl
need_bin nmcli
need_bin lsblk
need_bin lspci
need_bin lsusb

if [ ! -x /usr/bin/spike-greeter ]; then
  echo "E: spike-greeter missing (spike-shell package)" >&2
  fail=1
else
  echo "I: spike-greeter present"
fi
if [ ! -x /usr/lib/spike/spike-greeter-prepare ]; then
  echo "E: spike-greeter-prepare missing" >&2
  fail=1
else
  echo "I: spike-greeter-prepare present"
fi
if [ ! -f /lib/systemd/system/spike-greeter.service ] \
   && [ ! -f /usr/lib/systemd/system/spike-greeter.service ]; then
  echo "E: spike-greeter.service missing" >&2
  fail=1
else
  echo "I: spike-greeter.service present"
fi

# Spike APT plumbing (Enabled: no until package host is online — UPDATES.md)
if [ ! -f /usr/share/keyrings/spike-archive-keyring.gpg ]; then
  echo "E: spike-archive-keyring.gpg missing" >&2
  fail=1
else
  echo "I: spike-archive-keyring present"
fi
if [ ! -f /etc/apt/sources.list.d/spike.sources ]; then
  echo "E: /etc/apt/sources.list.d/spike.sources missing" >&2
  fail=1
else
  echo "I: spike.sources present"
fi
if ! dpkg-query -W -f='${Status}' unattended-upgrades 2>/dev/null | grep -q "install ok installed"; then
  echo "E: unattended-upgrades package missing" >&2
  fail=1
else
  echo "I: unattended-upgrades present"
fi

if [ "$fail" -ne 0 ]; then
  exit 1
fi
