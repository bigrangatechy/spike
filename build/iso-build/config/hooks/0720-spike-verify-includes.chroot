#!/bin/sh
# Fail the ISO build if critical Spike includes landed empty (caught WP/SpikeDark
# shipping as 0-byte and WirePlumber ignoring them).
set -eu

fail=0
check() {
  f="$1"
  min="${2:-1}"
  if [ ! -f "$f" ]; then
    echo "E: missing critical include: $f" >&2
    fail=1
    return
  fi
  bytes="$(wc -c <"$f" | tr -d ' ')"
  if [ "$bytes" -lt "$min" ]; then
    echo "E: critical include too small (${bytes}B < ${min}B): $f" >&2
    fail=1
  else
    echo "I: ok ${bytes}B $f"
  fi
}

check /usr/share/wireplumber/wireplumber.conf.d/51-spike-sof-hdmi-disable.conf 100
check /usr/share/color-schemes/SpikeDark.colors 500
check /etc/xdg/kwinrc 50
check /etc/xdg/kdeglobals 500
check /etc/xdg/menus/applications.menu 500
check /usr/share/icons/spike-icons/index.theme 50
check /etc/pipewire/pipewire.conf.d/99-spike.conf 50
check /usr/share/alsa/ucm2/Intel/sof-essx8336/HiFi.conf 500
check /etc/casper.conf 50
check /etc/profile.d/99-spike-autostart-session.sh 50

# sof-essx8336 HiFi must NOT pull HDMI (causes ASoC -5 spam + auto_null only).
# Match an active Include only — comments may mention the upstream directive.
if grep -E '^[[:space:]]*Include\.hdmi' /usr/share/alsa/ucm2/Intel/sof-essx8336/HiFi.conf >/dev/null 2>&1; then
  echo "E: sof-essx8336 HiFi.conf still includes HDMI — remove Include.hdmi" >&2
  fail=1
elif ! grep -q 'SectionVerb' /usr/share/alsa/ucm2/Intel/sof-essx8336/HiFi.conf 2>/dev/null; then
  echo "E: sof-essx8336 HiFi.conf missing SectionVerb" >&2
  fail=1
else
  echo "I: sof-essx8336 HiFi.conf has no HDMI include"
fi

# Live user must be spike (not ubuntu).
if ! grep -q 'USERNAME="spike"' /etc/casper.conf 2>/dev/null; then
  echo "E: /etc/casper.conf USERNAME is not spike" >&2
  fail=1
else
  echo "I: casper USERNAME=spike"
fi

# SVG icon engine required for Breeze panel icons.
if [ ! -e /usr/lib/x86_64-linux-gnu/qt6/plugins/iconengines/libqsvgicon.so ] &&
   ! ls /usr/lib/*/qt6/plugins/iconengines/libqsvgicon.so >/dev/null 2>&1; then
  echo "E: qt6 SVG icon engine missing (install qt6-svg-plugins)" >&2
  fail=1
else
  echo "I: qt6 SVG icon engine present"
fi

if [ ! -x /usr/bin/spike-rescue ]; then
  echo "E: spike-rescue missing (package spike-rescue into includes.chroot)" >&2
  fail=1
else
  echo "I: spike-rescue present"
fi

if [ ! -x /usr/lib/spike/spike-rescue-mount ]; then
  echo "E: spike-rescue-mount helper missing" >&2
  fail=1
elif [ ! -f /etc/sudoers.d/spike-rescue ]; then
  echo "E: /etc/sudoers.d/spike-rescue missing (passwordless RO mounts)" >&2
  fail=1
else
  echo "I: spike-rescue mount helper + sudoers present"
fi

if [ ! -x /usr/bin/spike-installer ]; then
  echo "E: spike-installer missing (package spike-installer into includes.chroot)" >&2
  fail=1
else
  echo "I: spike-installer present"
fi

if [ "$fail" -ne 0 ]; then
  exit 1
fi
