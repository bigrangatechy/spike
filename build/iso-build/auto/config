#!/bin/sh
# Spike live-build configuration — Ubuntu Server 26.04 (resolute), one hybrid ISO.
# Invoked by: lb config (via auto/ mechanism) or scripts/build-iso.sh
#
# Mirrors: default to au.archive.ubuntu.com for bootstrap, chroot, updates (volatile),
# and binary. security.ubuntu.com for -security.
# Override: SPIKE_UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu/ sudo ./scripts/build-iso.sh
set -e

MIRROR="${SPIKE_UBUNTU_MIRROR:-http://au.archive.ubuntu.com/ubuntu/}"
SEC_MIRROR="${SPIKE_UBUNTU_SECURITY_MIRROR:-http://security.ubuntu.com/ubuntu/}"

# Prefer gnupg in bootstrap if we ever use packages.chroot again.
# Ubuntu live-build 3.0~a57: no --bootstrap-include CLI; env can be wiped when
# lb config re-reads an existing empty config/bootstrap — force it after.
export LB_BOOTSTRAP_INCLUDE="${LB_BOOTSTRAP_INCLUDE:-apt-utils,ca-certificates,gnupg}"

lb config noauto \
	--mode ubuntu \
	--distribution resolute \
	--parent-distribution resolute \
	--architectures amd64 \
	--binary-images iso-hybrid \
	--debian-installer false \
	--archive-areas "main restricted universe multiverse" \
	--mirror-bootstrap "${MIRROR}" \
	--parent-mirror-bootstrap "${MIRROR}" \
	--mirror-chroot "${MIRROR}" \
	--parent-mirror-chroot "${MIRROR}" \
	--mirror-chroot-security "${SEC_MIRROR}" \
	--parent-mirror-chroot-security "${SEC_MIRROR}" \
	--mirror-chroot-volatile "${MIRROR}" \
	--parent-mirror-chroot-volatile "${MIRROR}" \
	--mirror-binary "${MIRROR}" \
	--parent-mirror-binary "${MIRROR}" \
	--mirror-binary-security "${SEC_MIRROR}" \
	--parent-mirror-binary-security "${SEC_MIRROR}" \
	--mirror-binary-volatile "${MIRROR}" \
	--parent-mirror-binary-volatile "${MIRROR}" \
	--mirror-debian-installer "${MIRROR}" \
	--parent-mirror-debian-installer "${MIRROR}" \
	--linux-flavours generic \
	--linux-packages "linux-image linux-headers" \
	--initramfs casper \
	--initsystem systemd \
	--apt-recommends false \
	--firmware-chroot false \
	--firmware-binary false \
	--memtest none \
	--bootloader grub2 \
	--grub-splash none \
	--security true \
	--volatile true \
	--iso-application "Spike Linux" \
	--iso-publisher "BigRangaTech; https://spike.bigrangatech.com" \
	--iso-volume "Spike 26.04" \
	--bootappend-live "boot=casper hostname=spike-live username=spike quiet splash" \
	"${@}"

# Re-apply after lb config (re-read of config/bootstrap clears the export).
if [ -f config/bootstrap ]; then
	sed -i 's|^LB_BOOTSTRAP_INCLUDE=.*|LB_BOOTSTRAP_INCLUDE="apt-utils,ca-certificates,gnupg"|' config/bootstrap
fi
