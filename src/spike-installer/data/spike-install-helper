#!/bin/sh
# Privileged Spike installer helper (INSTALLER.md).
# Invoked via: sudo -n /usr/lib/spike/spike-install-helper <command> …
# GUI never runs parted/mkfs as the live user.
set -eu

MNT="${SPIKE_INSTALL_MNT:-/mnt/spike}"
LOG="${SPIKE_INSTALL_LOG:-/var/log/spike/install.log}"

die() {
  echo "spike-install-helper: ERROR: $*" >&2
  echo "ERROR: $*" >>"$LOG" 2>/dev/null || true
  exit 1
}

log() {
  echo "$*"
  mkdir -p "$(dirname "$LOG")" 2>/dev/null || true
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $*" >>"$LOG" 2>/dev/null || true
}

is_efi() {
  [ -d /sys/firmware/efi ]
}

# Refuse installing onto the live medium itself.
refuse_live_disk() {
  disk="$1"
  disk="${disk%/}"
  for m in /cdrom /run/live/medium /lib/live/mount/medium /media/cdrom; do
    [ -e "$m" ] || continue
    src="$(findmnt -n -o SOURCE -T "$m" 2>/dev/null || true)"
    src="${src%%\[*}"
    [ -n "$src" ] || continue
    # Resolve partition → parent disk
    parent="$(lsblk -no PKNAME "$src" 2>/dev/null || true)"
    if [ -n "$parent" ]; then
      cand="/dev/$parent"
    else
      cand="$src"
    fi
    case "$cand" in
      "$disk"|"${disk}"*) die "refusing target $disk — looks like the live ISO medium ($cand via $m)" ;;
    esac
    case "$src" in
      "$disk"|"${disk}"*) die "refusing target $disk — live medium device $src" ;;
    esac
  done
}

assert_disk() {
  disk="$1"
  case "$disk" in
    /dev/sd[a-z]|/dev/vd[a-z]|/dev/xvd[a-z]|/dev/nvme[0-9]n[0-9]|/dev/mmcblk[0-9]) ;;
    *) die "refusing unusual disk name: $disk (expected whole-disk /dev/sdX|nvmeXnY|mmcblkN)" ;;
  esac
  [ -b "$disk" ] || die "not a block device: $disk"
  refuse_live_disk "$disk"
}

part_name() {
  disk="$1"
  n="$2"
  case "$disk" in
    *nvme*|*mmcblk*) printf '%sp%s\n' "$disk" "$n" ;;
    *) printf '%s%s\n' "$disk" "$n" ;;
  esac
}

find_squashfs() {
  for c in \
    /cdrom/casper/filesystem.squashfs \
    /run/live/medium/casper/filesystem.squashfs \
    /lib/live/mount/medium/casper/filesystem.squashfs \
    /media/cdrom/casper/filesystem.squashfs
  do
    if [ -f "$c" ]; then
      printf '%s\n' "$c"
      return 0
    fi
  done
  return 1
}

cmd_partition() {
  disk="$1"
  assert_disk "$disk"
  log "Partitioning $disk (EFI=$(is_efi && echo yes || echo no))"

  # Drop any holders
  swapoff -a 2>/dev/null || true
  umount -R "$MNT" 2>/dev/null || true
  for p in $(lsblk -ln -o NAME "$disk" | tail -n +2); do
    umount -l "/dev/$p" 2>/dev/null || true
  done
  wipefs -a "$disk" 2>/dev/null || true
  dd if=/dev/zero of="$disk" bs=1M count=8 status=none 2>/dev/null || true
  sync

  if is_efi; then
    parted -s "$disk" mklabel gpt
    parted -s "$disk" mkpart ESP fat32 1MiB 513MiB
    parted -s "$disk" set 1 esp on
    parted -s "$disk" mkpart root ext4 513MiB 100%
    sync
    sleep 1
    partprobe "$disk" 2>/dev/null || true
    sleep 1
    p1="$(part_name "$disk" 1)"
    p2="$(part_name "$disk" 2)"
    mkfs.vfat -F32 -n SPIKEEFI "$p1"
    mkfs.ext4 -F -L spike-root "$p2"
  else
    parted -s "$disk" mklabel msdos
    parted -s "$disk" mkpart primary ext4 1MiB 1025MiB
    parted -s "$disk" set 1 boot on
    parted -s "$disk" mkpart primary ext4 1025MiB 100%
    sync
    sleep 1
    partprobe "$disk" 2>/dev/null || true
    sleep 1
    p1="$(part_name "$disk" 1)"
    p2="$(part_name "$disk" 2)"
    mkfs.ext4 -F -L spike-boot "$p1"
    mkfs.ext4 -F -L spike-root "$p2"
  fi
  log "Partition + format done on $disk"
}

cmd_mount() {
  disk="$1"
  assert_disk "$disk"
  p1="$(part_name "$disk" 1)"
  p2="$(part_name "$disk" 2)"
  mkdir -p "$MNT"
  if is_efi; then
    mount "$p2" "$MNT"
    mkdir -p "$MNT/boot/efi"
    mount "$p1" "$MNT/boot/efi"
  else
    mount "$p2" "$MNT"
    mkdir -p "$MNT/boot"
    mount "$p1" "$MNT/boot"
  fi
  log "Mounted target under $MNT"
}

cmd_copy() {
  squash="$(find_squashfs)" || die "filesystem.squashfs not found (is the live medium mounted?)"
  log "Copying system from $squash → $MNT"
  mkdir -p "$MNT"
  if command -v unsquashfs >/dev/null 2>&1; then
    # -f overwrite, -d destination
    unsquashfs -f -d "$MNT" "$squash" || die "unsquashfs failed"
  else
    sqmnt="$(mktemp -d /tmp/spike-sqXXXXXX)"
    mount -o loop,ro "$squash" "$sqmnt" || die "loop-mount squashfs failed"
    rsync -aHAX --info=progress2 "$sqmnt"/ "$MNT"/ || {
      umount "$sqmnt" 2>/dev/null || true
      rmdir "$sqmnt" 2>/dev/null || true
      die "rsync from squashfs failed"
    }
    umount "$sqmnt"
    rmdir "$sqmnt" 2>/dev/null || true
  fi
  log "System copy complete"
}

cmd_fstab() {
  disk="$1"
  assert_disk "$disk"
  p1="$(part_name "$disk" 1)"
  p2="$(part_name "$disk" 2)"
  uuid_root="$(blkid -s UUID -o value "$p2")"
  uuid_boot="$(blkid -s UUID -o value "$p1")"
  {
    echo "# Generated by spike-install-helper"
    echo "UUID=$uuid_root / ext4 errors=remount-ro 0 1"
    if is_efi; then
      echo "UUID=$uuid_boot /boot/efi vfat umask=0077 0 1"
    else
      echo "UUID=$uuid_boot /boot ext4 defaults 0 2"
    fi
  } >"$MNT/etc/fstab"
  log "Wrote /etc/fstab"
}

# Fill XDG user dirs + Mozilla/LibreOffice roots for the installed user.
seed_installed_home() {
  user="$1"
  home="$MNT/home/$user"
  [ -n "$user" ] || return 0
  [ -d "$home" ] || mkdir -p "$home"

  for d in Desktop Documents Downloads Music Pictures Videos Templates Public \
    .mozilla/firefox .thunderbird .config/libreoffice/4/user .cache/mozilla .cache/thunderbird; do
    mkdir -p "$home/$d"
  done

  mkdir -p "$home/Desktop"
  if [ -f /usr/share/spike/desktop/spike-save-logs.desktop ]; then
    cp -f /usr/share/spike/desktop/spike-save-logs.desktop \
      "$home/Desktop/Copy Spike Logs to USB.desktop" 2>/dev/null || true
    chmod 755 "$home/Desktop/Copy Spike Logs to USB.desktop" 2>/dev/null || true
  elif [ -f "$MNT/usr/share/spike/desktop/spike-save-logs.desktop" ]; then
    cp -f "$MNT/usr/share/spike/desktop/spike-save-logs.desktop" \
      "$home/Desktop/Copy Spike Logs to USB.desktop" 2>/dev/null || true
    chmod 755 "$home/Desktop/Copy Spike Logs to USB.desktop" 2>/dev/null || true
  fi

  # user-dirs.dirs so apps see the folders before first graphical login
  mkdir -p "$home/.config"
  cat >"$home/.config/user-dirs.dirs" <<'EOF'
XDG_DESKTOP_DIR="$HOME/Desktop"
XDG_DOWNLOAD_DIR="$HOME/Downloads"
XDG_TEMPLATES_DIR="$HOME/Templates"
XDG_PUBLICSHARE_DIR="$HOME/Public"
XDG_DOCUMENTS_DIR="$HOME/Documents"
XDG_MUSIC_DIR="$HOME/Music"
XDG_PICTURES_DIR="$HOME/Pictures"
XDG_VIDEOS_DIR="$HOME/Videos"
EOF
  echo "en_US" >"$home/.config/user-dirs.locale" 2>/dev/null || true

  if chroot "$MNT" sh -c "command -v xdg-user-dirs-update >/dev/null"; then
    chroot "$MNT" runuser -u "$user" -- env HOME="/home/$user" xdg-user-dirs-update >/dev/null 2>&1 \
      || log "WARN: xdg-user-dirs-update failed for $user"
  fi

  chroot "$MNT" chown -R "$user:$user" "/home/$user" 2>/dev/null \
    || chown -R --reference="$home" "$home" 2>/dev/null \
    || true
  log "Seeded XDG + app profile dirs under /home/$user"
}

# Copy live Wi‑Fi/Ethernet NetworkManager profiles into the installed root so
# credentials from installer Step 3 (or the shell network applet) survive reboot.
# NOTE: `nmcli connection export` only supports VPN — build keyfiles ourselves.
copy_network_connections() {
  dest="$MNT/etc/NetworkManager/system-connections"
  mkdir -p "$dest"

  # 1) Keyfiles already on the live system (any known location)
  for dir in /etc/NetworkManager/system-connections \
             /run/NetworkManager/system-connections \
             /usr/lib/NetworkManager/system-connections; do
    [ -d "$dir" ] || continue
    for f in "$dir"/*; do
      [ -f "$f" ] || continue
      base="$(basename "$f")"
      case "$base" in
        .*|README*|default) continue ;;
      esac
      cp -a "$f" "$dest/" || true
    done
  done

  write_wifi_keyfile() {
    uuid="$1"
    name="$2"
    ssid="$3"
    psk="$4"
    key_mgmt="$5"
    safe="$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '_')"
    [ -n "$safe" ] || safe="$uuid"
    out="$dest/${safe}.nmconnection"
    {
      printf '%s\n' '[connection]'
      printf 'id=%s\n' "$name"
      printf 'uuid=%s\n' "$uuid"
      printf '%s\n' 'type=wifi'
      printf '%s\n' 'autoconnect=true'
      printf '%s\n' ''
      printf '%s\n' '[wifi]'
      printf '%s\n' 'mode=infrastructure'
      printf 'ssid=%s\n' "$ssid"
      printf '%s\n' ''
      if [ -n "$psk" ]; then
        printf '%s\n' '[wifi-security]'
        printf 'key-mgmt=%s\n' "${key_mgmt:-wpa-psk}"
        printf 'psk=%s\n' "$psk"
        printf '%s\n' ''
      fi
      printf '%s\n' '[ipv4]'
      printf '%s\n' 'method=auto'
      printf '%s\n' ''
      printf '%s\n' '[ipv6]'
      printf '%s\n' 'method=auto'
    } >"$out"
  }

  write_ethernet_keyfile() {
    uuid="$1"
    name="$2"
    safe="$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '_')"
    [ -n "$safe" ] || safe="$uuid"
    out="$dest/${safe}.nmconnection"
    {
      printf '%s\n' '[connection]'
      printf 'id=%s\n' "$name"
      printf 'uuid=%s\n' "$uuid"
      printf '%s\n' 'type=ethernet'
      printf '%s\n' 'autoconnect=true'
      printf '%s\n' ''
      printf '%s\n' '[ipv4]'
      printf '%s\n' 'method=auto'
      printf '%s\n' ''
      printf '%s\n' '[ipv6]'
      printf '%s\n' 'method=auto'
    } >"$out"
  }

  # 2) Rebuild from nmcli (covers in-memory / user-scoped connects; export is VPN-only)
  if command -v nmcli >/dev/null 2>&1; then
    # Prefer active connections first, then all wifi/ethernet.
    nmcli -t -f UUID,TYPE,NAME connection show 2>/dev/null | while IFS=: read -r uuid type name; do
      [ -n "$uuid" ] || continue
      case "$type" in
        802-11-wireless|wifi)
          # Prefer on-disk filename when NM already wrote a keyfile
          fname="$(nmcli -g connection.filename connection show uuid "$uuid" 2>/dev/null || true)"
          if [ -n "$fname" ] && [ -f "$fname" ]; then
            base="$(basename "$fname")"
            cp -a "$fname" "$dest/$base" 2>/dev/null || true
            continue
          fi
          ssid="$(nmcli -g 802-11-wireless.ssid connection show uuid "$uuid" 2>/dev/null || true)"
          [ -n "$ssid" ] || ssid="$name"
          psk="$(nmcli -s -g 802-11-wireless-security.psk connection show uuid "$uuid" 2>/dev/null || true)"
          key_mgmt="$(nmcli -g 802-11-wireless-security.key-mgmt connection show uuid "$uuid" 2>/dev/null || true)"
          write_wifi_keyfile "$uuid" "${name:-$ssid}" "$ssid" "$psk" "$key_mgmt"
          ;;
        802-3-ethernet|ethernet)
          fname="$(nmcli -g connection.filename connection show uuid "$uuid" 2>/dev/null || true)"
          if [ -n "$fname" ] && [ -f "$fname" ]; then
            base="$(basename "$fname")"
            cp -a "$fname" "$dest/$base" 2>/dev/null || true
            continue
          fi
          write_ethernet_keyfile "$uuid" "${name:-Wired}"
          ;;
        *) continue ;;
      esac
    done
  fi

  find "$dest" -type f -exec chmod 600 {} \; 2>/dev/null || true
  find "$dest" -type f -exec chown root:root {} \; 2>/dev/null || true

  n="$(find "$dest" -type f 2>/dev/null | wc -l | tr -d ' ')"
  n="${n:-0}"
  if [ "$n" -gt 0 ]; then
    log "Copied NetworkManager connections → installed system ($n file(s))"
  else
    log "WARN: no NetworkManager connections to copy (Wi‑Fi may need re-entry after install)"
  fi
}

# Ensure Spike APT source + keyring on the target (idempotent). Default Enabled: no
# until https://packages.bigrangatech.com/spike is online (UPDATES.md).
seed_spike_apt_source() {
  mkdir -p "$MNT/usr/share/keyrings" "$MNT/etc/apt/sources.list.d" \
    "$MNT/etc/apt/preferences.d"

  if [ -f /usr/share/keyrings/spike-archive-keyring.gpg ]; then
    cp -f /usr/share/keyrings/spike-archive-keyring.gpg \
      "$MNT/usr/share/keyrings/spike-archive-keyring.gpg"
  elif [ -f /etc/apt/trusted.gpg.d/spike.key ]; then
    cp -f /etc/apt/trusted.gpg.d/spike.key \
      "$MNT/usr/share/keyrings/spike-archive-keyring.gpg" 2>/dev/null || true
  fi

  if [ -f /etc/apt/sources.list.d/spike.sources ]; then
    cp -f /etc/apt/sources.list.d/spike.sources "$MNT/etc/apt/sources.list.d/spike.sources"
  elif [ ! -f "$MNT/etc/apt/sources.list.d/spike.sources" ]; then
    cat >"$MNT/etc/apt/sources.list.d/spike.sources" <<'EOF'
Types: deb
URIs: https://packages.bigrangatech.com/spike
Suites: spike
Components: main
Signed-By: /usr/share/keyrings/spike-archive-keyring.gpg
Enabled: no
EOF
  fi

  if [ -f /etc/apt/preferences.d/spike.pref ]; then
    cp -f /etc/apt/preferences.d/spike.pref "$MNT/etc/apt/preferences.d/spike.pref"
  fi

  # Operators can force-enable at install time once the host answers.
  if [ "${SPIKE_APT_ENABLE:-0}" = "1" ] || [ "${SPIKE_APT_ENABLE:-}" = "yes" ]; then
    if [ -f "$MNT/etc/apt/sources.list.d/spike.sources" ]; then
      sed -i 's/^Enabled:[[:space:]]*no/Enabled: yes/' \
        "$MNT/etc/apt/sources.list.d/spike.sources" 2>/dev/null || true
      log "Spike APT source Enabled: yes (SPIKE_APT_ENABLE)"
    fi
  else
    log "Spike APT source present (Enabled: no until package host is online)"
  fi
}

cmd_configure() {
  user="${SPIKE_INSTALL_USER:?}"
  host="${SPIKE_INSTALL_HOSTNAME:?}"
  lang="${SPIKE_INSTALL_LANG:-en_US.UTF-8}"
  tz="${SPIKE_INSTALL_TIMEZONE:-UTC}"
  keyboard="${SPIKE_INSTALL_KEYBOARD:-us}"
  variant="${SPIKE_INSTALL_VARIANT:-standard}"
  pwfile="${SPIKE_INSTALL_PASSWORD_FILE:-}"

  [ -d "$MNT/etc" ] || die "target root not mounted at $MNT"

  echo "$host" >"$MNT/etc/hostname"
  if [ -f "$MNT/etc/hosts" ]; then
    # Ensure loopback + hostname mapping (live image may have casper quirks).
    if ! grep -qE '^127\.0\.0\.1[[:space:]]' "$MNT/etc/hosts"; then
      echo "127.0.0.1\tlocalhost" >>"$MNT/etc/hosts"
    fi
    if grep -qE '^127\.0\.1\.1[[:space:]]' "$MNT/etc/hosts"; then
      sed -i "s/^127\\.0\\.1\\.1.*/127.0.1.1\t$host/" "$MNT/etc/hosts"
    else
      echo "127.0.1.1\t$host" >>"$MNT/etc/hosts"
    fi
  fi

  # Locale / timezone / keyboard
  if [ -f "$MNT/etc/locale.gen" ]; then
    sed -i "s/^# *${lang}/${lang}/" "$MNT/etc/locale.gen" 2>/dev/null || true
    # Also uncomment bare lang without .UTF-8 if present
    lang_base="${lang%%.*}"
    sed -i "s/^# *${lang_base}\\.UTF-8/${lang_base}.UTF-8/" "$MNT/etc/locale.gen" 2>/dev/null || true
  fi
  echo "LANG=$lang" >"$MNT/etc/default/locale"
  if [ -e "/usr/share/zoneinfo/$tz" ]; then
    ln -sf "/usr/share/zoneinfo/$tz" "$MNT/etc/localtime"
    echo "$tz" >"$MNT/etc/timezone"
  else
    log "WARN: timezone $tz not found under /usr/share/zoneinfo — leaving default"
  fi

  # Debian/Ubuntu console + XKB keyboard (console-setup / keyboard-configuration)
  cat >"$MNT/etc/default/keyboard" <<EOF
XKBMODEL="pc105"
XKBLAYOUT="$keyboard"
XKBVARIANT=""
XKBOPTIONS=""
BACKSPACE="guess"
EOF
  log "Wrote /etc/default/keyboard XKBLAYOUT=$keyboard"

  # Copy live NetworkManager Wi‑Fi/Ethernet profiles into the installed system
  # so credentials from installer Step 3 work after reboot (INSTALLER.md).
  copy_network_connections

  # Spike APT source + keyring (Enabled: no until packages.bigrangatech.com is live).
  seed_spike_apt_source

  mount --bind /dev "$MNT/dev" 2>/dev/null || true
  mount --bind /proc "$MNT/proc" 2>/dev/null || true
  mount --bind /sys "$MNT/sys" 2>/dev/null || true
  mount --bind /run "$MNT/run" 2>/dev/null || true

  if chroot "$MNT" sh -c 'command -v locale-gen >/dev/null'; then
    chroot "$MNT" locale-gen "$lang" >>"$LOG" 2>&1 \
      || chroot "$MNT" locale-gen >>"$LOG" 2>&1 \
      || log "WARN: locale-gen failed for $lang"
  fi
  if chroot "$MNT" sh -c 'command -v update-locale >/dev/null'; then
    chroot "$MNT" update-locale "LANG=$lang" >>"$LOG" 2>&1 || true
  fi
  if chroot "$MNT" sh -c 'command -v setupcon >/dev/null'; then
    chroot "$MNT" setupcon --force >>"$LOG" 2>&1 \
      || log "WARN: setupcon failed (console keymap may need reboot)"
  fi

  chroot "$MNT" useradd -m -s /bin/bash \
    -G sudo,audio,video,input,render,plugdev,netdev,pipewire "$user" 2>/dev/null \
    || chroot "$MNT" useradd -m -s /bin/bash "$user" 2>/dev/null \
    || log "WARN: useradd may have failed (user might exist)"

  # Squashfs live user may already exist without DRM/seat groups — live overlay
  # groups from spike-live-groups do NOT persist into the image. Always enforce.
  chroot "$MNT" usermod -aG \
    sudo,audio,video,input,render,plugdev,netdev,pipewire "$user" 2>/dev/null \
    || log "WARN: usermod groups failed for $user"

  # Fill XDG home (Documents/Pictures/…) + app profile roots for the new user.
  seed_installed_home "$user"

  if [ -n "$pwfile" ] && [ -f "$pwfile" ]; then
    pw="$(cat "$pwfile")"
    echo "$user:$pw" | chroot "$MNT" chpasswd
    shred -u "$pwfile" 2>/dev/null || rm -f "$pwfile"
  fi

  # Mark installed system. Auto-login is optional (default: login prompt on tty1).
  mkdir -p "$MNT/etc/spike" "$MNT/etc/systemd/system/getty@tty1.service.d" \
    "$MNT/var/log/spike" "$MNT/var/lib/spike/installer-notifications"
  touch "$MNT/etc/spike/installed"
  # First-boot wizard gate (BOOT-PROCESS.md); shell also uses ~/.config/spike/first_run_completed.
  touch "$MNT/var/lib/spike/first-boot"
  chmod 666 "$MNT/var/lib/spike/first-boot" 2>/dev/null || true
  log "Wrote /var/lib/spike/first-boot + installer-notifications/"
  chown root:adm "$MNT/var/log/spike" 2>/dev/null || true
  chmod 775 "$MNT/var/log/spike" 2>/dev/null || true
  # Allow the desktop user to write session logs (same path live capture reads).
  chroot "$MNT" usermod -aG adm "$user" 2>/dev/null || true

  auto_login="${SPIKE_INSTALL_AUTO_LOGIN:-0}"
  if [ "$auto_login" = "1" ] || [ "$auto_login" = "yes" ] || [ "$auto_login" = "true" ]; then
    cat >"$MNT/etc/systemd/system/getty@tty1.service.d/autologin.conf" <<EOF
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin $user --noclear %I \$TERM
Type=idle
EOF
    chroot "$MNT" systemctl disable spike-greeter.service 2>/dev/null || true
    chroot "$MNT" systemctl enable getty@tty1.service 2>/dev/null || true
    log "Enabled tty1 auto-login for $user (text getty → spike-session)"
  else
    # Graphical spike-greeter on tty1. Keep getty@tty1 *enabled* as fallback —
    # greeter Conflicts=getty while running; OnFailure + StartLimit bring getty
    # back if linuxfb dies (do NOT disable getty — that caused black-after-GRUB).
    rm -f "$MNT/etc/systemd/system/getty@tty1.service.d/autologin.conf"
    chroot "$MNT" systemctl enable getty@tty1.service 2>/dev/null || true
    if [ -f "$MNT/usr/lib/systemd/system/spike-greeter.service" ] \
       || [ -f "$MNT/lib/systemd/system/spike-greeter.service" ]; then
      chroot "$MNT" systemctl enable spike-greeter.service 2>/dev/null \
        || log "WARN: could not enable spike-greeter.service"
      log "Enabled spike-greeter + getty@tty1 fallback (OnFailure)"
    else
      log "spike-greeter.service missing — text getty login only"
    fi
  fi

  # seatd is required for kwin --drm (live uses system seatd). Enable on install.
  if chroot "$MNT" sh -c 'command -v seatd >/dev/null && [ -f /lib/systemd/system/seatd.service -o -f /usr/lib/systemd/system/seatd.service ]'; then
    chroot "$MNT" systemctl enable seatd.service >>"$LOG" 2>&1 \
      || log "WARN: could not enable seatd.service"
  else
    log "WARN: seatd not present in target — session may fall back to logind"
  fi

  # Start Spike Shell after a successful tty1 login (password or auto-login).
  cat >"$MNT/etc/profile.d/99-spike-autostart-session.sh" <<'EOF'
# Spike: start graphical session after tty1 login (live or installed).
case "$-" in
  *i*) ;;
  *) return 0 ;;
esac

_live=0
grep -Eqw 'boot=casper' /proc/cmdline 2>/dev/null && _live=1
_installed=0
[ -f /etc/spike/installed ] && _installed=1
[ "$_live" -eq 1 ] || [ "$_installed" -eq 1 ] || return 0

[ "$(id -u)" -ne 0 ] || return 0
[ -z "${WAYLAND_DISPLAY:-}" ] || return 0
[ -z "${DISPLAY:-}" ] || return 0
[ -n "${XDG_SESSION_ID:-}" ] || return 0
[ -z "${SPIKE_SESSION_STARTED:-}" ] || return 0

_tty="$(tty 2>/dev/null || true)"
case "$_tty" in
  /dev/tty1) ;;
  *) return 0 ;;
esac

command -v spike-session >/dev/null 2>&1 || return 0

# Hard requirement for DRM/seatd — warn loudly if groups missing.
for _g in video input render; do
  if ! id -nG 2>/dev/null | tr ' ' '\n' | grep -qx "$_g"; then
    echo "spike: WARNING: not in group '$_g' — desktop may be a black screen. Fix: sudo usermod -aG video,input,render \$USER && reboot" >&2
  fi
done

export SPIKE_SESSION_STARTED=1
echo "spike: starting desktop session (Ctrl+Alt+F2 for a text console)…"
exec spike-session
EOF

  # Drop live-only passwordless installer sudoers on the installed system.
  rm -f "$MNT/etc/sudoers.d/spike-installer"

  # Live ISO units must not run on the installed system.
  rm -f "$MNT/etc/systemd/system/"*.wants/casper.service \
    "$MNT/etc/systemd/system/"*.wants/casper-md5check.service \
    "$MNT/etc/systemd/system/"*.wants/live-config.service \
    "$MNT/etc/systemd/system/"*.wants/spike-live-groups.service \
    "$MNT/etc/systemd/system/"*.wants/spike-capture-logs.service \
    "$MNT/etc/systemd/system/"*.wants/spike-capture-finalize.service \
    2>/dev/null || true
  rm -f "$MNT/etc/systemd/system/spike-live-groups.service" \
    "$MNT/etc/systemd/system/spike-capture-logs.service" \
    "$MNT/etc/systemd/system/spike-capture-finalize.service" \
    2>/dev/null || true

  # Remove live Desktop install launchers from the new user's Desktop.
  for desk in "$MNT/home/$user/Desktop" "$MNT/etc/skel/Desktop"; do
    [ -d "$desk" ] || continue
    rm -f "$desk/Install Spike.desktop" "$desk/Move My Files.desktop" 2>/dev/null || true
  done

  mkdir -p "$MNT/var/lib/spike/config"
  if [ -x "$MNT/usr/bin/spike-config" ]; then
    chroot "$MNT" spike-config --init-state 2>/dev/null || true
    chroot "$MNT" spike-config --state-set desktop variant "$variant" 2>/dev/null || true
    if [ "$auto_login" = "1" ] || [ "$auto_login" = "yes" ] || [ "$auto_login" = "true" ]; then
      chroot "$MNT" spike-config --state-set installer auto_login true 2>/dev/null || true
    else
      chroot "$MNT" spike-config --state-set installer auto_login false 2>/dev/null || true
    fi
    # Hardware detect on the *target machine* (sysfs already bind-mounted) fills
    # security.module_blacklist (KERNEL.md) before generate-all writes modprobe.d.
    log "Running spike-config --detect (hardware + module blacklist)"
    if chroot "$MNT" spike-config --detect >>"$LOG" 2>&1; then
      log "Hardware detect OK"
    else
      log "WARN: spike-config --detect failed — blacklist may be empty"
    fi
    chroot "$MNT" spike-config --generate-all 2>/dev/null || true
    if [ -f "$MNT/etc/modprobe.d/spike-blacklist.conf" ]; then
      bl_count="$(grep -cE '^blacklist ' "$MNT/etc/modprobe.d/spike-blacklist.conf" 2>/dev/null || true)"
      bl_count="${bl_count:-0}"
      log "Wrote module blacklist ($bl_count entries) → /etc/modprobe.d/spike-blacklist.conf"
    else
      log "WARN: spike-blacklist.conf missing after generate-all"
    fi
  else
    printf '{"variant":"%s"}\n' "$variant" >"$MNT/var/lib/spike/config/install-variant.json" || true
  fi

  log "Configured user=$user host=$host variant=$variant (installed session path ready)"
}

# Live squashfs ships grub-*-bin without metapackages → no /etc/default/grub and
# often no /boot/grub. Without those, update-grub fails and firmware lands in grub>.
# spike-config --generate-all may also write GRUB_THEME/FONT to missing theme assets.
ensure_grub_defaults() {
  mkdir -p "$MNT/boot/grub" "$MNT/etc/default/grub.d"
  if [ ! -f "$MNT/etc/default/grub" ]; then
    if [ -f /usr/share/grub/default/grub ]; then
      cp -f /usr/share/grub/default/grub "$MNT/etc/default/grub"
    else
      cat >"$MNT/etc/default/grub" <<'EOF'
# Generated by spike-install-helper
GRUB_DEFAULT=0
GRUB_TIMEOUT_STYLE=menu
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="Spike"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""
GRUB_DISABLE_OS_PROBER=true
EOF
    fi
  fi
  # Avoid os-prober probing the live USB / other disks during install.
  if ! grep -q '^GRUB_DISABLE_OS_PROBER=' "$MNT/etc/default/grub" 2>/dev/null; then
    echo 'GRUB_DISABLE_OS_PROBER=true' >>"$MNT/etc/default/grub"
  else
    sed -i 's/^#\?GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=true/' "$MNT/etc/default/grub"
  fi
  # Prefer a visible menu for pre-alpha recovery (user reported grub> shell).
  sed -i 's/^GRUB_TIMEOUT_STYLE=.*/GRUB_TIMEOUT_STYLE=menu/' "$MNT/etc/default/grub" 2>/dev/null || true
  if grep -q '^GRUB_TIMEOUT=' "$MNT/etc/default/grub"; then
    sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=5/' "$MNT/etc/default/grub"
  else
    echo 'GRUB_TIMEOUT=5' >>"$MNT/etc/default/grub"
  fi
  # Install GRUB theme from spike-branding when present (squashfs may already
  # have /boot/grub/themes/spike; also copy from /usr/share/spike/grub).
  if [ -d /usr/share/spike/grub ]; then
    mkdir -p "$MNT/boot/grub/themes/spike"
    cp -a /usr/share/spike/grub/. "$MNT/boot/grub/themes/spike/" 2>/dev/null || true
  fi
  # spike-config ships theme paths that are not on the live squashfs → grub-probe
  # fails ("failed to get canonical path of …/font.pf2") and update-grub aborts.
  if [ ! -f "$MNT/boot/grub/themes/spike/theme.txt" ]; then
    sed -i -E 's/^(GRUB_THEME=)/#\1/; s/^(GRUB_BACKGROUND=)/#\1/; s/^(GRUB_FONT=)/#\1/' \
      "$MNT/etc/default/grub" 2>/dev/null || true
    sed -i 's/^GRUB_TERMINAL_OUTPUT=gfxterm/#GRUB_TERMINAL_OUTPUT=gfxterm/' \
      "$MNT/etc/default/grub" 2>/dev/null || true
  else
    # Theme present — ensure GRUB_THEME is active (may have been commented earlier).
    if ! grep -q '^GRUB_THEME=' "$MNT/etc/default/grub" 2>/dev/null; then
      echo 'GRUB_THEME=/boot/grub/themes/spike/theme.txt' >>"$MNT/etc/default/grub"
      echo 'GRUB_TERMINAL_OUTPUT=gfxterm' >>"$MNT/etc/default/grub"
      echo 'GRUB_GFXMODE=auto' >>"$MNT/etc/default/grub"
    fi
  fi
  # Never leave casper live args in installed GRUB cmdline.
  if grep -Eq 'boot=casper|casper' "$MNT/etc/default/grub" 2>/dev/null; then
    sed -i -E 's/\s*boot=casper\b//g; s/\s*casper\b//g' "$MNT/etc/default/grub" || true
  fi
  # Override live initrd default-boot-to-casper even if update-initramfs is skipped.
  if grep -q '^GRUB_CMDLINE_LINUX=' "$MNT/etc/default/grub"; then
    if ! grep -Eq '^GRUB_CMDLINE_LINUX=.*boot=local' "$MNT/etc/default/grub"; then
      sed -i -E 's/^GRUB_CMDLINE_LINUX="([^"]*)"/GRUB_CMDLINE_LINUX="\1 boot=local"/' \
        "$MNT/etc/default/grub"
      sed -i -E 's/^GRUB_CMDLINE_LINUX=" boot=local"/GRUB_CMDLINE_LINUX="boot=local"/' \
        "$MNT/etc/default/grub"
    fi
  else
    echo 'GRUB_CMDLINE_LINUX="boot=local"' >>"$MNT/etc/default/grub"
  fi
}

# Live initrd has conf.d/default-boot-to-casper.conf → BOOT=casper unless overridden.
# Without regenerating initramfs (or boot=local on cmdline), installed boots drop into
# "(initramfs) unable to find a medium containing a live file system".
prepare_local_initramfs() {
  mkdir -p "$MNT/etc/initramfs-tools/conf.d"
  cat >"$MNT/etc/initramfs-tools/conf.d/spike-installed.conf" <<'EOF'
# Installed Spike — do not default to casper live boot.
BOOT=local
EOF
  # Stop the casper hook from re-injecting default-boot-to-casper on rebuild.
  if [ -f "$MNT/usr/share/initramfs-tools/hooks/casper" ]; then
    chmod a-x "$MNT/usr/share/initramfs-tools/hooks/casper" 2>/dev/null || true
  fi
  # Drop live-only wants again (generate-all / dpkg may have recreated nothing here).
  rm -f "$MNT/etc/systemd/system/"*.wants/casper.service \
    "$MNT/etc/systemd/system/"*.wants/casper-md5check.service 2>/dev/null || true

  # Activate Spike Plymouth theme before regenerating initramfs (quiet+splash).
  # Ubuntu has no plymouth-set-default-theme — use update-alternatives.
  set_plymouth_theme() {
    theme_name="$1"
    theme_file="/usr/share/plymouth/themes/${theme_name}/${theme_name}.plymouth"
    if [ ! -f "$MNT${theme_file}" ]; then
      return 1
    fi
    if chroot "$MNT" sh -c "command -v update-alternatives >/dev/null"; then
      chroot "$MNT" update-alternatives --install \
        /usr/share/plymouth/themes/default.plymouth default.plymouth \
        "$theme_file" 200 >>"$LOG" 2>&1 || true
      chroot "$MNT" update-alternatives --set default.plymouth "$theme_file" \
        >>"$LOG" 2>&1 || true
      return 0
    fi
    mkdir -p "$MNT/usr/share/plymouth/themes"
    ln -sfn "$theme_file" "$MNT/usr/share/plymouth/themes/default.plymouth"
    return 0
  }
  if [ -d "$MNT/usr/share/plymouth/themes/spike-minimal" ]; then
    if set_plymouth_theme spike-minimal; then
      log "Plymouth theme set to spike-minimal (update-alternatives)"
    else
      log "WARN: failed to activate spike-minimal Plymouth theme"
    fi
  else
    log "WARN: spike-minimal Plymouth theme missing on target"
  fi

  if ! chroot "$MNT" sh -c 'command -v update-initramfs >/dev/null'; then
    log "WARN: update-initramfs missing — GRUB will pass boot=local as fallback"
    return 0
  fi
  log "Regenerating initramfs for local (non-casper) boot"
  if chroot "$MNT" update-initramfs -u -k all >>"$LOG" 2>&1; then
    log "update-initramfs OK"
  else
    log "WARN: update-initramfs failed — see $LOG (boot=local on GRUB cmdline still set)"
  fi
}

# Emergency menu if update-grub cannot run (still better than bare grub>).
write_minimal_grub_cfg() {
  disk="$1"
  p1="$(part_name "$disk" 1)"
  p2="$(part_name "$disk" 2)"
  uuid_root="$(blkid -s UUID -o value "$p2")"
  [ -n "$uuid_root" ] || die "could not read root UUID for minimal grub.cfg"
  kpath="$(ls -1 "$MNT"/boot/vmlinuz-* 2>/dev/null | head -n1 || true)"
  [ -n "$kpath" ] || die "no vmlinuz-* under target /boot for minimal grub.cfg"
  kver="${kpath##*/vmlinuz-}"
  ipath="$MNT/boot/initrd.img-$kver"
  [ -f "$ipath" ] || die "missing initrd.img-$kver for minimal grub.cfg"
  mkdir -p "$MNT/boot/grub"
  if is_efi; then
    # Kernels live on the root filesystem at /boot/…
    cat >"$MNT/boot/grub/grub.cfg" <<EOF
# Minimal Spike grub.cfg (update-grub fallback)
set default=0
set timeout=5
insmod part_gpt
insmod ext2
insmod gzio
menuentry "Spike Linux" {
  search --no-floppy --fs-uuid --set=root $uuid_root
  linux /boot/vmlinuz-$kver root=UUID=$uuid_root ro quiet splash boot=local
  initrd /boot/initrd.img-$kver
}
EOF
  else
    uuid_boot="$(blkid -s UUID -o value "$p1")"
    [ -n "$uuid_boot" ] || die "could not read boot UUID for minimal grub.cfg"
    # Separate /boot partition → kernels at /
    cat >"$MNT/boot/grub/grub.cfg" <<EOF
# Minimal Spike grub.cfg (update-grub fallback)
set default=0
set timeout=5
insmod part_msdos
insmod ext2
insmod gzio
menuentry "Spike Linux" {
  search --no-floppy --fs-uuid --set=root $uuid_boot
  linux /vmlinuz-$kver root=UUID=$uuid_root ro quiet splash boot=local
  initrd /initrd.img-$kver
}
EOF
  fi
  log "Wrote minimal /boot/grub/grub.cfg (kernel $kver)"
}

cmd_bootloader() {
  disk="$1"
  assert_disk "$disk"
  [ -d "$MNT/etc" ] || die "target not mounted"

  mount --bind /dev "$MNT/dev" 2>/dev/null || true
  mount --bind /proc "$MNT/proc" 2>/dev/null || true
  mount --bind /sys "$MNT/sys" 2>/dev/null || true
  mount --bind /run "$MNT/run" 2>/dev/null || true

  ensure_grub_defaults
  prepare_local_initramfs

  if ! chroot "$MNT" sh -c 'command -v grub-install >/dev/null'; then
    die "grub-install missing in target (need grub2-common + grub-*-bin in squashfs)"
  fi

  if is_efi; then
    mkdir -p "$MNT/boot/efi" "$MNT/sys/firmware/efi/efivars"
    mount --bind /sys/firmware/efi/efivars "$MNT/sys/firmware/efi/efivars" 2>/dev/null || true
    log "Installing UEFI GRUB (bootloader-id=Spike)"
    chroot "$MNT" grub-install --target=x86_64-efi --efi-directory=/boot/efi \
      --bootloader-id=Spike --recheck "$disk" >>"$LOG" 2>&1 \
      || die "grub-install (UEFI) failed — see $LOG"
    # Removable path so firmwares that ignore NVRAM BootOrder still find an EFI binary.
    log "Installing UEFI GRUB removable fallback (EFI/BOOT)"
    chroot "$MNT" grub-install --target=x86_64-efi --efi-directory=/boot/efi \
      --removable --recheck "$disk" >>"$LOG" 2>&1 \
      || log "WARN: grub-install --removable failed (NVRAM Spike entry may still work)"
  else
    log "Installing BIOS GRUB"
    chroot "$MNT" grub-install --target=i386-pc --recheck "$disk" >>"$LOG" 2>&1 \
      || die "grub-install (BIOS) failed — see $LOG"
  fi

  log "Running update-grub"
  if chroot "$MNT" update-grub >>"$LOG" 2>&1; then
    log "update-grub OK"
    # Belt-and-suspenders: if leftover live initrd still has casper default, force local.
    if ! grep -Eqw 'boot=local' "$MNT/boot/grub/grub.cfg" 2>/dev/null; then
      sed -i -E 's|(linux[^\n]*root=UUID=[^ ]+)|\1 boot=local|g' "$MNT/boot/grub/grub.cfg" 2>/dev/null \
        || true
    fi
  else
    log "WARN: update-grub failed — installing minimal grub.cfg fallback"
    write_minimal_grub_cfg "$disk"
  fi

  [ -s "$MNT/boot/grub/grub.cfg" ] || die "grub.cfg missing after bootloader step"
  if grep -Eqw 'boot=casper' "$MNT/boot/grub/grub.cfg" 2>/dev/null; then
    die "grub.cfg still contains boot=casper — refusing to leave live boot on installed disk"
  fi
  log "Bootloader installed on $disk (grub.cfg $(wc -c <"$MNT/boot/grub/grub.cfg") bytes)"
}

# Flatten SpikeBackup session into new home (home/<old>/Documents/… → Documents/…).
# Mirrors spike-common stripHomePrefix / buildRestoreMappings.
cmd_restore_shell_flatten() {
  session="$1"
  dest="$2"
  copied=0
  # Portable find|while (no mapfile).
  find "$session" -type f ! -name 'REPORT.txt' -print 2>/dev/null | while IFS= read -r src; do
    rel="${src#"$session"/}"
    case "$rel" in
      home/*|Users/*|Home/*)
        # Drop home|Users and the username segment.
        rest="${rel#*/}"   # after home/
        rest="${rest#*/}"  # after username/
        mapped="$rest"
        ;;
      Documents/*|Pictures/*|Videos/*|Movies/*|Music/*|Downloads/*|Desktop/*)
        mapped="$rel"
        ;;
      *)
        # Skip OS noise / unknown trees
        continue
        ;;
    esac
    [ -n "$mapped" ] || continue
    out="$dest/$mapped"
    mkdir -p "$(dirname "$out")" || continue
    cp -a "$src" "$out" || continue
    copied=$((copied + 1))
  done
  # Note: copied count in subshell — verify at least one mapped file or empty session.
  find "$dest" -type f ! -name 'SpikeRestore-REPORT.txt' 2>/dev/null | head -n1 | grep -q . \
    || [ "$(find "$session" -type f ! -name 'REPORT.txt' 2>/dev/null | wc -l | tr -d ' ')" = "0" ] \
    || return 1
  return 0
}

cmd_restore() {
  session="${1:-}"
  user="${SPIKE_INSTALL_USER:?}"
  [ -n "$session" ] || die "restore session path required"
  [ -d "$session" ] || die "restore session missing: $session"
  dest="$MNT/home/$user"
  [ -d "$dest" ] || die "target home missing: $dest"
  log "Layer 4 restore: $session → $dest"

  if command -v spike-rescue >/dev/null 2>&1; then
    log "Trying spike-rescue --batch-restore"
    if spike-rescue --batch-restore --session "$session" --home "$dest" >>"$LOG" 2>&1; then
      chroot "$MNT" chown -R "$user:$user" "/home/$user" 2>/dev/null || true
      log "Layer 4 restore via spike-rescue OK"
      return 0
    fi
    log "WARN: spike-rescue --batch-restore failed — falling back to shell flatten"
  else
    log "spike-rescue not on PATH — using shell flatten"
  fi

  cmd_restore_shell_flatten "$session" "$dest" || {
    log "WARN: Layer 4 restore flatten failed"
    return 1
  }
  chroot "$MNT" chown -R "$user:$user" "/home/$user" 2>/dev/null || true
  log "Layer 4 restore complete (shell flatten)"
  return 0
}

cmd_umount() {
  sync
  umount -R "$MNT" 2>/dev/null || umount -l "$MNT" 2>/dev/null || true
  log "Unmounted $MNT"
}

# Parse install-all argv into SPIKE_INSTALL_* (sudo strips env by default).
parse_install_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --disk) SPIKE_INSTALL_DISK="${2:?}"; shift 2 ;;
      --user) SPIKE_INSTALL_USER="${2:?}"; shift 2 ;;
      --hostname) SPIKE_INSTALL_HOSTNAME="${2:?}"; shift 2 ;;
      --lang) SPIKE_INSTALL_LANG="${2:?}"; shift 2 ;;
      --timezone) SPIKE_INSTALL_TIMEZONE="${2:?}"; shift 2 ;;
      --keyboard) SPIKE_INSTALL_KEYBOARD="${2:?}"; shift 2 ;;
      --variant) SPIKE_INSTALL_VARIANT="${2:?}"; shift 2 ;;
      --password-file) SPIKE_INSTALL_PASSWORD_FILE="${2:?}"; shift 2 ;;
      --confirm) SPIKE_INSTALL_CONFIRM="${2:?}"; shift 2 ;;
      --restore-session) SPIKE_INSTALL_RESTORE_SESSION="${2:?}"; shift 2 ;;
      --auto-login) SPIKE_INSTALL_AUTO_LOGIN=1; shift ;;
      --) shift; break ;;
      -*) die "unknown install-all option: $1" ;;
      *) die "unexpected argument: $1" ;;
    esac
  done
  export SPIKE_INSTALL_DISK SPIKE_INSTALL_USER SPIKE_INSTALL_HOSTNAME
  export SPIKE_INSTALL_LANG SPIKE_INSTALL_TIMEZONE SPIKE_INSTALL_KEYBOARD SPIKE_INSTALL_VARIANT
  export SPIKE_INSTALL_PASSWORD_FILE SPIKE_INSTALL_CONFIRM SPIKE_INSTALL_RESTORE_SESSION
  export SPIKE_INSTALL_AUTO_LOGIN
}

cmd_install_all() {
  disk="${SPIKE_INSTALL_DISK:?}"
  assert_disk "$disk"
  [ "${SPIKE_INSTALL_CONFIRM:-}" = "ERASE" ] || die "SPIKE_INSTALL_CONFIRM must be ERASE (pass --confirm ERASE)"

  log "=== Spike install start disk=$disk user=${SPIKE_INSTALL_USER:-?} ==="
  cmd_partition "$disk"
  cmd_mount "$disk"
  cmd_copy
  cmd_fstab "$disk"
  cmd_configure
  cmd_bootloader "$disk"
  if [ -n "${SPIKE_INSTALL_RESTORE_SESSION:-}" ]; then
    if cmd_restore "$SPIKE_INSTALL_RESTORE_SESSION"; then
      log "RESTORE_STATUS=ok"
    else
      log "RESTORE_STATUS=failed"
      log "WARN: restore failed (install otherwise OK)"
    fi
  else
    log "RESTORE_STATUS=skipped"
  fi
  # Persist the live install transcript onto the installed disk for post-install USB copy.
  if [ -f "$LOG" ] && [ -d "$MNT/var/log/spike" ]; then
    cp -a "$LOG" "$MNT/var/log/spike/install-from-live.log" 2>/dev/null \
      || log "WARN: could not copy install.log onto target"
    chown root:adm "$MNT/var/log/spike/install-from-live.log" 2>/dev/null || true
    chmod 664 "$MNT/var/log/spike/install-from-live.log" 2>/dev/null || true
    log "Copied install transcript → /var/log/spike/install-from-live.log on target"
  fi
  # Live-only capture binary is useless installed (units already stripped).
  rm -f "$MNT/usr/sbin/spike-capture-logs" 2>/dev/null || true
  cmd_umount
  log "=== Spike install finished OK ==="
  echo "OK"
}

usage() {
  cat <<'EOF'
Usage: spike-install-helper <command> [args]

  partition <disk>
  mount <disk>
  copy
  fstab <disk>
  configure
  bootloader <disk>
  restore <session>
  umount
  install-all --disk DEV --user NAME --hostname HOST --confirm ERASE
              [--lang L] [--timezone TZ] [--keyboard LAYOUT] [--variant standard|plus]
              [--password-file PATH] [--restore-session DIR]

Env (optional fallback): SPIKE_INSTALL_DISK, USER, HOSTNAME, LANG, TIMEZONE,
  KEYBOARD, VARIANT, PASSWORD_FILE, RESTORE_SESSION, CONFIRM, MNT, LOG
EOF
}

cmd="${1:-}"
shift || true
case "$cmd" in
  partition) cmd_partition "${1:?disk}" ;;
  mount) cmd_mount "${1:?disk}" ;;
  copy) cmd_copy ;;
  fstab) cmd_fstab "${1:?disk}" ;;
  configure) cmd_configure ;;
  bootloader) cmd_bootloader "${1:?disk}" ;;
  restore) cmd_restore "${1:?session}" ;;
  umount) cmd_umount ;;
  install-all)
    parse_install_args "$@"
    cmd_install_all
    ;;
  -h|--help|help|"") usage; exit 0 ;;
  *) die "unknown command: $cmd" ;;
esac
