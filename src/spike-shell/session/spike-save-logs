#!/bin/bash
# Spike — save focused diagnostics to a USB stick (installed system or live).
# Spec intent: Jessie plugs a spare USB, double-clicks Desktop icon, hands stick
# to the agent via scripts/spike-collect-usb-logs.sh.
#
# Usage:
#   spike-save-logs              # auto-pick / auto-mount a writable USB
#   spike-save-logs /path/to/usb
#   spike-save-logs --full       # also dump full journal + dmesg (large)
set -euo pipefail

FULL=0
DEST_ROOT=""
for arg in "$@"; do
  case "$arg" in
    --full|-f) FULL=1 ;;
    --help|-h)
      cat <<'EOF'
Usage: spike-save-logs [--full] [USB_MOUNT]

Writes spike-logs-<UTC>/ onto a USB stick with session, NM, KWin Night Light,
journal (filtered), packages, and install.log when present.

  --full   Also include full journal + dmesg (large; usually not needed)

On the build host after you plug the stick in:
  sudo ./scripts/spike-collect-usb-logs.sh /run/media/$USER/<stick>
  # or: ./scripts/spike-collect-usb-logs.sh   (auto LABEL=writable)
EOF
      exit 0
      ;;
    -*)
      echo "unknown option: $arg (try --help)" >&2
      exit 1
      ;;
    *)
      DEST_ROOT="$arg"
      ;;
  esac
done

TS="$(date -u +%Y%m%dT%H%M%SZ)"
HOST="$(hostname 2>/dev/null || echo spike)"
USER_NAME="$(id -un 2>/dev/null || echo unknown)"

is_writable_dir() {
  [ -d "$1" ] && [ -w "$1" ]
}

# Mount LABEL=writable if present but unmounted (common when re-plugging the
# live stick into an installed system — udisks often leaves HintAuto=false).
try_mount_writable_label() {
  local dev mnt out
  if findmnt -n -S LABEL=writable >/dev/null 2>&1; then
    return 0
  fi
  [ -b /dev/disk/by-label/writable ] || return 1
  dev="$(readlink -f /dev/disk/by-label/writable 2>/dev/null || true)"
  [ -n "$dev" ] || return 1
  if command -v udisksctl >/dev/null 2>&1; then
    out="$(udisksctl mount -b "$dev" 2>&1 || true)"
    echo "$out" >&2 || true
    return 0
  fi
  mnt="/run/media/${USER_NAME}/writable"
  mkdir -p "$mnt" 2>/dev/null || mnt="/tmp/spike-writable-$$"
  mkdir -p "$mnt" 2>/dev/null || return 1
  if mount "$dev" "$mnt" 2>/dev/null; then
    echo "mounted $dev → $mnt" >&2
    return 0
  fi
  return 1
}

# Prefer an explicit path, else removable mounts under /run/media|/media,
# else LABEL=writable (live USB), else fail clearly.
pick_usb() {
  if [ -n "$DEST_ROOT" ]; then
    if is_writable_dir "$DEST_ROOT"; then
      printf '%s\n' "$DEST_ROOT"
      return 0
    fi
    echo "error: not a writable directory: $DEST_ROOT" >&2
    return 1
  fi

  try_mount_writable_label || true

  local cand root_src src
  root_src="$(findmnt -n -o SOURCE / 2>/dev/null || true)"

  # Dedicated rescue mount of the live stick (partition root — best dest).
  for cand in /run/spike-rescue/dest-writable; do
    if is_writable_dir "$cand"; then
      printf '%s\n' "$cand"
      return 0
    fi
  done

  for base in "/run/media/${USER_NAME}" "/media/${USER_NAME}" /run/media /media; do
    [ -d "$base" ] || continue
    # Newest mounts first (likely the stick just plugged in).
    while IFS= read -r cand; do
      [ -n "$cand" ] || continue
      is_writable_dir "$cand" || continue
      case "$cand" in
        /cdrom|/log-persistence) continue ;;
      esac
      # Skip casper's /var/log bind of writable — SpikeBackup/logs belong at
      # partition root; still allow if nothing else exists (handled later).
      if [ "$cand" = "/var/log" ] || [ "$cand" = "/var/log/" ]; then
        continue
      fi
      src="$(findmnt -n -o SOURCE -T "$cand" 2>/dev/null || true)"
      if [ -n "$root_src" ] && [ "$src" = "$root_src" ]; then
        continue
      fi
      printf '%s\n' "$cand"
      return 0
    done < <(find "$base" -mindepth 1 -maxdepth 2 -type d 2>/dev/null | sort -r)
  done

  if command -v findmnt >/dev/null 2>&1; then
    local w lab
    # Prefer a real partition-root mount of LABEL=writable (not /var/log).
    while IFS= read -r w; do
      [ -n "$w" ] || continue
      case "$w" in
        /var/log|/var/log/*) continue ;;
      esac
      if is_writable_dir "$w"; then
        printf '%s\n' "$w"
        return 0
      fi
    done < <(findmnt -n -o TARGET -S LABEL=writable 2>/dev/null || true)

    # Last resort: casper /var/log bind (better than losing logs).
    w="$(findmnt -n -o TARGET -S LABEL=writable 2>/dev/null | head -n1 || true)"
    if [ -n "$w" ] && is_writable_dir "$w"; then
      echo "note: using casper writable bind at $w (prefer remount at partition root)" >&2
      printf '%s\n' "$w"
      return 0
    fi
  fi

  for cand in /media/writable /mnt/writable /log-persistence; do
    if is_writable_dir "$cand"; then
      printf '%s\n' "$cand"
      return 0
    fi
  done

  echo "error: no writable USB found." >&2
  echo "  Plug in a USB stick, wait for it to appear under /run/media/${USER_NAME}/," >&2
  echo "  or mount the live stick writable partition, then re-run:" >&2
  echo "  spike-save-logs /run/media/${USER_NAME}/<stick-name>" >&2
  if [ -b /dev/disk/by-label/writable ]; then
    echo "  hint: LABEL=writable exists but is not mounted — try:" >&2
    echo "    udisksctl mount -b /dev/disk/by-label/writable" >&2
  fi
  return 1
}

notify() {
  local msg="$1"
  echo "$msg"
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a Spike "Spike logs" "$msg" 2>/dev/null || true
  fi
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title "Spike logs" --msgbox "$msg" 2>/dev/null || true
  elif command -v zenity >/dev/null 2>&1; then
    zenity --info --title="Spike logs" --text="$msg" 2>/dev/null || true
  fi
}

fail_ui() {
  local msg="$1"
  echo "$msg" >&2
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a Spike -u critical "Spike logs" "$msg" 2>/dev/null || true
  fi
  if command -v kdialog >/dev/null 2>&1; then
    kdialog --title "Spike logs" --error "$msg" 2>/dev/null || true
  elif command -v zenity >/dev/null 2>&1; then
    zenity --error --title="Spike logs" --text="$msg" 2>/dev/null || true
  fi
}

USB="$(pick_usb)" || {
  fail_ui "No writable USB found. Plug in a stick (or mount LABEL=writable) and try again."
  # Keep terminal open when launched from Desktop (Terminal=true).
  if [ -t 0 ] && [ -t 1 ]; then
    echo
    read -r -p "Press Enter to close…" _ || true
  fi
  exit 1
}

OUT="${USB}/spike-logs-${TS}"
if ! mkdir -p "$OUT" "$OUT/session-logs" "$OUT/config" "$OUT/network"; then
  fail_ui "Could not create ${OUT} (permission denied?)."
  if [ -t 0 ] && [ -t 1 ]; then
    read -r -p "Press Enter to close…" _ || true
  fi
  exit 1
fi

{
  echo "spike-logs ${TS}"
  echo "host=${HOST} user=${USER_NAME}"
  echo "full=${FULL}"
  echo "usb=${USB}"
  echo "cmdline: $(cat /proc/cmdline 2>/dev/null || true)"
  echo "uname: $(uname -a 2>/dev/null || true)"
  if [ -f /etc/spike/installed ]; then
    echo "mode=installed"
  else
    echo "mode=live-or-unknown"
  fi
  echo "focus: session night-light networkmanager install backup"
} >"$OUT/meta.txt"

# Packages / versions
{
  dpkg -l 'spike-*' 'kwin-wayland' 'network-manager' 'packagekit' 2>&1 || true
  command -v spike-shell spike-session spike-installer spike-rescue spike-config 2>&1 || true
  spike-shell --version 2>&1 || true
  spike-config --version 2>&1 || true
} >"$OUT/packages.txt" 2>&1 || true

# spike-config state (no secrets expected)
{
  spike-config --state 2>&1 || true
} >"$OUT/spike-config-state.txt" 2>&1 || true

# Session / seat
{
  echo "=== loginctl ==="
  loginctl 2>&1 || true
  echo "=== seat0 ==="
  loginctl show-seat seat0 2>&1 || true
  echo "=== env ==="
  echo "XDG_SESSION_ID=${XDG_SESSION_ID:-}"
  echo "XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-}"
  echo "WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}"
  echo "XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-}"
} >"$OUT/session.txt" 2>&1 || true

# Copy session logs
copied=0
for f in \
  "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/spike-session.log" \
  /var/log/spike/session-latest.log \
  /var/log/spike-session-latest.log \
  /var/log/spike/install.log \
  /var/log/spike/install-from-live.log \
  /var/log/spike/night-light.log \
  /var/log/spike/backup-scan.log \
  "${XDG_STATE_HOME:-$HOME/.local/state}/spike/night-light.log" \
  /var/log/spike/*.log
do
  [ -f "$f" ] || continue
  cp -a "$f" "$OUT/session-logs/" 2>/dev/null || true
  copied=1
done
if [ "$copied" -eq 0 ]; then
  echo "no session logs under /var/log/spike or XDG_RUNTIME_DIR" >"$OUT/session-logs/README.txt"
fi

# KWin Night Light + plugins (the knobs we write)
if [ -f "${HOME}/.config/kwinrc" ]; then
  cp -a "${HOME}/.config/kwinrc" "$OUT/config/kwinrc" 2>/dev/null || true
fi
if [ -f /etc/xdg/kwinrc ]; then
  cp -a /etc/xdg/kwinrc "$OUT/config/kwinrc.xdg" 2>/dev/null || true
fi
{
  echo "=== NightLight D-Bus (if session bus) ==="
  if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || [ -S "${XDG_RUNTIME_DIR:-}/bus" ]; then
    busctl --user introspect org.kde.KWin /org/kde/KWin/NightLight 2>&1 | head -n 80 || true
    busctl --user get-property org.kde.KWin /org/kde/KWin/NightLight \
      org.kde.KWin.NightLight enabled 2>&1 || true
    busctl --user get-property org.kde.KWin /org/kde/KWin/NightLight \
      org.kde.KWin.NightLight currentTemperature 2>&1 || true
    busctl --user get-property org.kde.KWin /org/kde/KWin/NightLight \
      org.kde.KWin.NightLight mode 2>&1 || true
  else
    echo "(no session bus — run from the desktop session)"
  fi
} >"$OUT/config/nightlight-dbus.txt" 2>&1 || true

# NetworkManager (no secrets by default)
{
  echo "=== nmcli general ==="
  nmcli general 2>&1 || true
  echo "=== device ==="
  nmcli -t device 2>&1 || true
  echo "=== connections (no secrets) ==="
  nmcli -t -f NAME,UUID,TYPE,DEVICE,FILENAME,AUTOCONNECT connection show 2>&1 || true
  echo "=== active ==="
  nmcli -t connection show --active 2>&1 || true
  echo "=== system-connections listing ==="
  ls -la /etc/NetworkManager/system-connections 2>&1 || true
} >"$OUT/network/nmcli.txt" 2>&1 || true

# Filtered journal — shell / kwin / NM / night light / installer
journalctl -b --no-pager \
  -g 'spike-shell|spike-session|spike-config|spike-install|spike-rescue|kwin|NightLight|NightColor|NetworkManager|nmcli|PackageKit|pkgcli|wayland|libinput|seat|drm|LayerShell' \
  >"$OUT/journal-filtered.txt" 2>&1 || true

journalctl -b --no-pager -u NetworkManager.service -u PackageKit.service \
  >"$OUT/journal-nm-pk.txt" 2>&1 || true

if [ "$FULL" = 1 ]; then
  journalctl -b --no-pager >"$OUT/journal-full.txt" 2>&1 || true
  dmesg >"$OUT/dmesg.txt" 2>&1 || true
fi

# Human README for Jessie / agent
cat >"$OUT/README.txt" <<EOF
Spike diagnostic bundle (${TS})

What to do:
  1. Safely eject this USB on Spike.
  2. On the build PC: sudo ./scripts/spike-collect-usb-logs.sh /run/media/\$USER/<this-stick>
  3. Tell the agent which spike-logs-* folder to read + what you saw on screen.

Contents (focused — not a full system dump):
  meta.txt                 — host / installed-vs-live
  packages.txt             — spike-* package versions
  spike-config-state.txt   — settings state
  session-logs/            — spike-session + install.log
  config/kwinrc            — Night Light keys
  config/nightlight-dbus.txt
  network/nmcli.txt        — Wi‑Fi / connections (no passwords)
  journal-filtered.txt     — shell/kwin/NM/installer lines this boot
EOF

sync || true
notify "Saved logs to ${OUT}"
echo "$OUT" >"$OUT/CAPTURE_PATH.txt"
ls -la "$OUT" || true
if [ -t 0 ] && [ -t 1 ]; then
  echo
  read -r -p "Press Enter to close…" _ || true
fi
exit 0
