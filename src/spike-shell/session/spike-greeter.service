[Unit]
Description=Spike graphical login greeter (tty1)
Documentation=file:///usr/share/doc/spike-shell/README
# Quiet/splash boots: wait until Plymouth fully releases the console/fb.
After=systemd-user-sessions.service seatd.service
After=plymouth-quit.service plymouth-quit-wait.service
Wants=plymouth-quit.service plymouth-quit-wait.service
Conflicts=getty@tty1.service
# Stop getty fully *before* greeter paints — otherwise getty's TTYReset can
# wipe the framebuffer right after the login UI flashes on screen.
After=getty@tty1.service
# If linuxfb greeter fails, bring text login back (avoid black screen after GRUB).
OnFailure=getty@tty1.service
StartLimitBurst=3
StartLimitIntervalSec=30
ConditionPathExists=/etc/spike/installed

[Service]
Type=simple
# Order matters: runtime dir → release Plymouth/fb → greeter UI.
ExecStartPre=/bin/mkdir -p /run/spike-greeter
ExecStartPre=/bin/chmod 700 /run/spike-greeter
ExecStartPre=/usr/lib/spike/spike-greeter-prepare
ExecStart=/usr/bin/spike-greeter
Restart=on-failure
RestartSec=2
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
# Do not deallocate VT on stop — fights Plymouth teardown / getty fallback.
TTYVTDisallocate=no
# linuxfb after splash; session starts via login -f after PAM.
Environment=QT_QPA_PLATFORM=linuxfb
Environment=QT_QPA_FB=/dev/fb0
Environment=XDG_RUNTIME_DIR=/run/spike-greeter

[Install]
WantedBy=multi-user.target
