#!/bin/sh
# Prepare tty1 / framebuffer for spike-greeter after quiet+splash boots.
# Plymouth often still owns DRM/fb until quit-wait; starting linuxfb too early
# yields a black screen (works on debug boots without splash).
set -eu

# Ask Plymouth to release the console; ignore if not running.
if command -v plymouth >/dev/null 2>&1; then
  plymouth quit --wait 2>/dev/null || plymouth quit 2>/dev/null || true
fi

# Ensure we are on tty1 before Qt opens the VT.
if command -v chvt >/dev/null 2>&1; then
  chvt 1 2>/dev/null || true
fi

# Quiet the kernel console so it does not paint over linuxfb after Qt draws.
if [ -w /sys/class/graphics/fbcon/cursor_blink ]; then
  echo 0 >/sys/class/graphics/fbcon/cursor_blink 2>/dev/null || true
fi
# Unbind fbcon from the VT consoles — late setfont/console-setup otherwise
# redraws text over the greeter ~1–2s after first paint (looks like a black flash).
for _vtcon in /sys/class/vtconsole/vtcon*/bind; do
  [ -w "$_vtcon" ] || continue
  echo 0 >"$_vtcon" 2>/dev/null || true
done
if [ -w /sys/class/graphics/fb0/blank ]; then
  echo 0 >/sys/class/graphics/fb0/blank 2>/dev/null || true
fi
if command -v setterm >/dev/null 2>&1 && [ -c /dev/tty1 ]; then
  setterm --blank 0 --powersave off --cursor off </dev/tty1 >/dev/tty1 2>/dev/null || true
fi
# Hide cursor / disable blanking via CSI (works even without setterm).
if [ -c /dev/tty1 ]; then
  printf '\033[9;0]\033[?33l\033[?25l\033[?1c' >/dev/tty1 2>/dev/null || true
fi

# Wait briefly for a usable framebuffer / DRM node after splash teardown.
i=0
while [ "$i" -lt 50 ]; do
  if [ -e /dev/fb0 ] || [ -e /dev/dri/card0 ]; then
    break
  fi
  i=$((i + 1))
  sleep 0.1
done

# Settle after Plymouth DRM handoff / console-setup.
sleep 0.4

exit 0
