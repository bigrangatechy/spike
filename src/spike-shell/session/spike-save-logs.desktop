[Desktop Entry]
Type=Application
Version=1.0
Name=Copy Spike Logs to USB
Comment=Save session / Night Light / Wi‑Fi diagnostics onto a plugged-in USB stick
# No Terminal= — Spike may not wire x-terminal-emulator; use kdialog/notify instead.
Exec=/usr/bin/spike-save-logs
Icon=document-save
Terminal=false
Categories=System;X-Spike-Tools;
StartupNotify=true
